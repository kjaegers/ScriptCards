| style="padding: 0 1em; font-size: 16px; font-weight: 100; text-align:center; background-color:#F6F5F5; color:#000000;"  | <span style="font-weight:bold;">Yes</span>
|-
| style="font-size: 18px; font-weight: 700; text-align:center; background-color:#c2c2c2; color:#000000;"                | -nei
