  --/|Escape button-list text for 5ECAM_CACHE. Only escape colon, semicolon, and pipe. Do not escape tilde or sheet-button tilde syntax breaks.
  --:MULE_BTN_CACHE_ESC|sourceVar;destVar
  --&[%2%]|[&[%1%]]
  --&[%2%]|[&[%2%](replaceall,,:,!#!)]
  --&[%2%]|[&[%2%](replaceall,;,!$!)]
  --&[%2%]|[&[%2%](replaceall,|,!@!)]
  --<|

  --/|Restore button-list text read from 5ECAM_CACHE attributes.
  --:MULE_BTN_CACHE_UNESC|sourceVar;destVar
  --&[%2%]|[&[%1%]]
  --&[%2%]|[&[%2%](replaceall,!#!,:)]
  --&[%2%]|[&[%2%](replaceall,!$!,;)]
  --&[%2%]|[&[%2%](replaceall,!@!,|)]
  --<|

