  --/|Read ability into roll vars via [*S] or [*[char_id]]. Early exit on blank or 0 keeps copied dmgMod. PC attacks set _gamCharId.
  --:Get_Ability_Modifier|attribute_string;returnnumericvalue;returnnamestring
  --?"[%1%]" -eq ""|<
  --?"[%1%]" -eq "NoRepeatingAttributeLoaded"|<
  --?"[%1%]" -eq "0"|<
  --?"[%1%]" -eq "-1"|<
  --?"[%1%]" -eq "0"|<
  --?"[%1%]" -eq "-1"|<
  --?"[%1%]" -eq "undefined"|<
  --=[%2%]|
  --&[%3%]|
  --&_gamModCid|[&_gamCharId]
  --?"X[&_gamModCid]" -eq "X" -or "[&_gamModCid]" -eq ""|&_gamModCid;[*S:character_id]
  --?"[%1%]" -eq "strength_mod"|=[%2%];[*[&_gamModCid]:strength_mod]
  --?"[%1%]" -eq "strength_mod"|&[%3%];[STR]
  --?"[%1%]" -eq "intelligence_mod"|=[%2%];[*[&_gamModCid]:intelligence_mod]
  --?"[%1%]" -eq "intelligence_mod"|&[%3%];[INT]
  --?"[%1%]" -eq "wisdom_mod"|=[%2%];[*[&_gamModCid]:wisdom_mod]
  --?"[%1%]" -eq "wisdom_mod"|&[%3%];[WIS]
  --?"[%1%]" -eq "dexterity_mod"|=[%2%];[*[&_gamModCid]:dexterity_mod]
  --?"[%1%]" -eq "dexterity_mod"|&[%3%];[DEX]
  --?"[%1%]" -eq "constitution_mod"|=[%2%];[*[&_gamModCid]:constitution_mod]
  --?"[%1%]" -eq "constitution_mod"|&[%3%];[CON]
  --?"[%1%]" -eq "charisma_mod"|=[%2%];[*[&_gamModCid]:charisma_mod]
  --?"[%1%]" -eq "charisma_mod"|&[%3%];[CHA]
  --<|

  --/|If dmgMod path left mod at 0, append [*[char]:ability_mod] to the roll string (Melee or Ranged).
  --:PC_ATK_S_ABI_FALLBACK|arString;dmgroll;dmgroll2
  --&_gamModCid|[&_gamCharId]
  --?"X[&_gamModCid]" -eq "X" -or "[&_gamModCid]" -eq ""|&_gamModCid;[*S:character_id]
  --?"[*R:attack_type]" -inc "Ranged"|[
   --?"[%1%]" -eq "arString"|&arString;+ + [*[&_gamModCid]:dexterity_mod] [DEX]
   --?"[%1%]" -eq "dmgroll"|&dmgroll;+ + [*[&_gamModCid]:dexterity_mod] [DEX]
   --?"[%1%]" -eq "dmgroll2"|&dmgroll2;+ + [*[&_gamModCid]:dexterity_mod] [DEX]
   --<|
  --]|
  --?"[%1%]" -eq "arString"|&arString;+ + [*[&_gamModCid]:strength_mod] [STR]
  --?"[%1%]" -eq "dmgroll"|&dmgroll;+ + [*[&_gamModCid]:strength_mod] [STR]
  --?"[%1%]" -eq "dmgroll2"|&dmgroll2;+ + [*[&_gamModCid]:strength_mod] [STR]
  --<|

  --/|There are four different options for applying damage. The selected option is set in the settings area of the macro.
  --/|Token-mod apply (ApplyDamageTokenmod). Relative barN_value deltas only. Do not re-set unchanged bars. No sheet hp_temp sync.
  --/|sync on token-mod temp writes (avoids double temp loss). Compatible with listen_to_tokenmod|1 change:graphic triggers.

  --/|Set damageApplyRoutine + damageRoutine from settings (menu init and attack/damage reentry).
  --:CAM_SetDamageApplyRoutines|
  --&_dmgRouteScript|[&damageApplyScript]
  --?"[&damageApplyScript]" -eq "damagebuttons"|&_dmgRouteScript;scriptcards
  --&damageApplyRoutine|DontApplyDamage
  --?"X[&UseTempHP]" -eq "X1"|[
   --?"[&_dmgRouteScript]" -eq "scriptcards"|&damageApplyRoutine;ApplyDamageScriptCardsTempHP
   --?"[&_dmgRouteScript]" -eq "token-mod"|&damageApplyRoutine;ApplyDamageTokenmodTempHP
   --?"[&_dmgRouteScript]" -eq "alterbars"|&damageApplyRoutine;ApplyDamageAlterbarsTempHP
  --]|
  --?"X[&UseTempHP]" -ne "X1"|[
   --?"[&_dmgRouteScript]" -eq "scriptcards"|&damageApplyRoutine;ApplyDamageScriptCardsSingle
   --?"[&_dmgRouteScript]" -eq "token-mod"|&damageApplyRoutine;ApplyDamageTokenmodSingle
   --?"[&_dmgRouteScript]" -eq "alterbars"|&damageApplyRoutine;ApplyDamageAlterbarsSingle
  --]|
  --?"[&damageApplyRoutine]" -eq "DontApplyDamage"|[
   --?"[&_dmgRouteScript]" -eq "token-mod"|&damageApplyRoutine;ApplyDamageTokenmodSingle
   --?"[&_dmgRouteScript]" -eq "scriptcards"|&damageApplyRoutine;ApplyDamageScriptCardsSingle
   --?"[&_dmgRouteScript]" -eq "alterbars"|&damageApplyRoutine;ApplyDamageAlterbarsSingle
  --]|
  --?[&damageApplyScript] -eq "damagebuttons"|&damageRoutine;SHOW_DAMAGE_BUTTONS
  --?"[&damageApplyScript]" -ne "damagebuttons"|&damageRoutine;CAM_ApplyDamageOrHealing
  --<|

  --/|Diagnostics only (CamTargetDebug|1). Does not change targeting or AC logic.
  --:CAM_TargetDebugWhisper|title;body
  --?"[&CamTargetDebug]" -ne "1"|<
  --#whisper|self,gm
  --+[%1%]|[%2%]
  --<|

  --:CAM_TargetDebugSnapshot|tokenId;label
  --?"[&CamTargetDebug]" -ne "1"|<
  --?"[%1%]" -eq "NONE"|<
  --?"X[%1%]" -eq "X"|<
  --?"[%1%]" -eq ""|<
  --&_camSnapTid|[%1%]
  --&_tdsTname|[*[&_camSnapTid]:t-name]
  --&_tdsCid|[*[&_camSnapTid]:character_id]
  --&_tdsNpc|[*[&_camSnapTid]:npc]
  --&_tdsTokAc|[*[&_camSnapTid]:ac]
  --&_tdsSheetAc|
  --?"X[&_tdsCid]" -ne "X" -and "[&_tdsCid]" -ne ""|&_tdsSheetAc;[*[&_tdsCid]:ac]
  --&_tdsTctxName|[*T:t-name]
  --&_tdsTctxCid|[*T:character_id]
  --&_tdsTctxAc|[*T:ac]
  --&_tdsTctxNpcAc|[*T:npc_ac]
  -->CAM_TargetDebugWhisper|[%2%]|snapTid=[&_camSnapTid] id t-name=[&_tdsTname] cid=[&_tdsCid] npc=[&_tdsNpc] id tokAC=[&_tdsTokAc] sheetAC=[&_tdsSheetAc] *T t-name=[&_tdsTctxName] *T cid=[&_tdsTctxCid] *T ac=[&_tdsTctxAc] *T npc_ac=[&_tdsTctxNpcAc]
  --<|

  --/|Like LibSN_APPLY_DAMAGE_OR_HEALING: signed amount — negative = damage, positive = healing.
  --/|Healing always uses main-HP apply (UseTempHP|0 / Single). Damage uses [&damageApplyRoutine] (TempHP when UseTempHP|1).
  --:CAM_ApplyDamageOrHealing|tokenid;hp bar#;temp bar#;amount;display;allow overheal;allow negative hp
  -->_ResolveDamageAmount|[%4%]
  --?[$_applyValue] -ge 0|[
   -->CAM_ApplyDOR_MainHPOnly|[%1%];[%2%];[%3%];[%4%];[%5%];[%6%];[%7%]
   --^CAM_ApplyDOR_Done|
  --]|
  -->[&damageApplyRoutine]|[%1%];[%2%];[%3%];[%4%];[%5%];[%6%];[%7%]
  --:CAM_ApplyDOR_Done|
  --<|

  --:CAM_ApplyDOR_MainHPOnly|tokenid;hp bar#;temp bar#;amount;display;allow overheal;allow negative hp
  --&_camDORRoute|[&damageApplyScript]
  --?"[&damageApplyScript]" -eq "damagebuttons"|&_camDORRoute;scriptcards
  --?"[&_camDORRoute]" -eq "scriptcards"|[
   -->ApplyDamageScriptCardsSingle|[%1%];[%2%];[%3%];[%4%];[%5%];[%6%];[%7%]
   --^CAM_ApplyDOR_MainHPOnly_Done|
  --]|
  --?"[&_camDORRoute]" -eq "alterbars"|[
   -->ApplyDamageAlterbarsSingle|[%1%];[%2%];[%3%];[%4%];[%5%];[%6%];[%7%]
   --^CAM_ApplyDOR_MainHPOnly_Done|
  --]|
  -->ApplyDamageTokenmodSingle|[%1%];[%2%];[%3%];[%4%];[%5%];[%6%];[%7%]
  --:CAM_ApplyDOR_MainHPOnly_Done|
  --<|

  --/|Read temp HP from token bar. If bar empty or 0, fall back to character hp_temp (common on NPCs).
  --:ReadTokenTempHP|tokenId;tempBarNum;returnVarName
   --&_rtthVal|[*[%1%]:t-bar[%2%]_value]
   --?"X[&_rtthVal]" -eq "X"|&_rtthVal;0
   --?"[&_rtthVal]" -eq ""|&_rtthVal;0
   --?"[&_rtthVal]" -eq "undefined"|&_rtthVal;0
   --?"[&_rtthVal]" -eq "0"|[
    --?"X[*[%1%]:character_id]" -ne "X"|[
     --&_tempFromSheet|[*[*[%1%]:character_id]:hp_temp]
     --?"X[&_tempFromSheet]" -ne "X" -and "[&_tempFromSheet]" -ne "" -and "[&_tempFromSheet]" -ne "0"|&_rtthVal;[&_tempFromSheet]
    --]|
   --]|
   --&[%3%]|[&_rtthVal]
   --<|

  --/|1 if token bar N exists for AlterBars / !t (max or value readable). 0 = PC sheet-only temp (hp_temp).
  --:CAM_TokenBarExists|tokenId;barNum;returnVarName
   --&_tbeExists|0
   --&_tbeMax|[*[%1%]:t-bar[%2%]_max]
   --?"X[&_tbeMax]" -ne "X"|&_tbeExists;1
   --?"[&_tbeMax]" -ne "" -and "[&_tbeMax]" -ne "undefined"|&_tbeExists;1
   --?"[&_tbeExists]" -eq "1"|[
    --&[%3%]|1
    --<|
   --]|
   --&_tbeVal|[*[%1%]:t-bar[%2%]_value]
   --?"X[&_tbeVal]" -ne "X"|&_tbeExists;1
   --?"[&_tbeVal]" -ne "" -and "[&_tbeVal]" -ne "undefined"|&_tbeExists;1
   --&[%3%]|[&_tbeExists]
   --<|

  --/|Keep sheet hp_temp in sync when temp bar changes (OGL).
  --:SyncTempHPSheet|tokenId;newTempValue
   --?"X[*[%1%]:character_id]" -eq "X"|<
   --!a:[*[%1%]:character_id]|!hp_temp:[%2%]
   --<|

  --/|Adjust incoming damage for temporary HP. Positive amounts (healing) pass through unchanged.
  --/|Reads temp HP from the token bar. Sets &_tempAdjAmount, &_tempNewValue, &_tempAlterDelta (for AlterBars), &_tempBarChanged (0/1).
  --:ADJUST_DAMAGE_FOR_TEMP_HP|TokenID;tempHPbar;Amount
  --&_tempAdjAmount|[%3%]
  --&_tempNewValue|
  --&_tempAlterDelta|0
  --=_tempAlterDeltaRoll|0
  --&_tempBarChanged|0
  --?"[%2%]" -eq ""|<
  --=TempHPIncoming|[%3%]
  --?[$TempHPIncoming.Raw] -ge 0|<
  -->ReadTokenTempHP|[%1%];[%2%];TempHPCurrentValue
  --?"[&TempHPCurrentValue]" -eq ""|<
  --?"[&TempHPCurrentValue]" -eq "undefined"|<
  --=TempHPCurrent|[&TempHPCurrentValue]
  --?[$TempHPCurrent.Raw] -le 0|<
  --=TempHPDamage|[$TempHPIncoming.Raw] {NEGATE}
  --?[$TempHPCurrent.Raw] -ge [$TempHPDamage.Raw]|ADJUST_TEMP_HP_ABSORBS_ALL
  --=TempHPAdjustedDamage|[$TempHPIncoming.Raw] + [$TempHPCurrent.Raw]
  --&_tempAdjAmount|[$TempHPAdjustedDamage.Raw]
  --&_tempNewValue|0
  --=TempAlterDelta|0 - [$TempHPCurrent.Raw]
  --&_tempAlterDelta|[$TempAlterDelta.Raw]
  --=_tempAlterDeltaRoll|[$TempAlterDelta.Raw]
  --&_tempBarChanged|1
  --^ADJUST_TEMP_HP_DONE|
  --:ADJUST_TEMP_HP_ABSORBS_ALL|
  --=TempHPRemaining|[$TempHPCurrent.Raw] - [$TempHPDamage.Raw]
  --&_tempAdjAmount|0
  --&_tempNewValue|[$TempHPRemaining.Raw]
  --=TempAlterDelta|[$TempHPRemaining.Raw] - [$TempHPCurrent.Raw]
  --&_tempAlterDelta|[$TempAlterDelta.Raw]
  --=_tempAlterDeltaRoll|[$TempAlterDelta.Raw]
  --&_tempBarChanged|1
  --:ADJUST_TEMP_HP_DONE|
  --<|

  --/|ScriptCards !t-only bar sync (ApplyDamageScriptCards TempHP path). Token-mod path must not call this.
  --:SYNC_TEMP_HP_BAR|TokenID;tempHPbar;newValue
  -->CAM_TokenBarExists|[%1%];[%2%];_syncTempBarExists
  --?"[&_syncTempBarExists]" -eq "1"|[
   --@token-mod|_ignore-selected _ids [%1%] _set bar[%2%]_value|[%3%]
   --!t:[%1%]|bar[%2%]_value|[%3%]
  --]|
  --?"X[*[%1%]:character_id]" -ne "X"|--!a:[*[%1%]:character_id]|!hp_temp:[%3%]
  --<|

  --/|Shared: resolve roll amount (Total if non-zero, else Raw). Sets _applyValue.
  --:_ResolveDamageAmount|amount
  --=_applyIn|[%1%]
  --=dmgTotalRoll|[$_applyIn.Total]
  --=dmgRawRoll|[$_applyIn.Raw]
  --?"[$dmgTotalRoll.Raw]" -ne "0"|=dmgResolvedRoll;[$dmgTotalRoll.Raw]
  --?"[$dmgTotalRoll.Raw]" -eq "0"|=dmgResolvedRoll;[$dmgRawRoll.Raw]
  --=_applyValue|[$dmgResolvedRoll.Raw]
  --<|

  --/|Shared: current HP + _applyValue -> _newValue, then clamp using AllowNegativeHP and allow-overheal param.
  --:_ComputeClampedHP|tokenId;hpBar;allowOverheal
  --=StartHP|[*[%1%]:t-bar[%2%]_value]
  --=_newValue|[$StartHP] + [$_applyValue]
  --?"X[&AllowNegativeHP]" -ne "X1" -and [$_newValue] -lt 0|=_newValue;0
  --?"X[%3%]" -ne "X1" -and [$_newValue] -gt [*[%1%]:t-bar[%2%]_max]|=_newValue;[*[%1%]:t-bar[%2%]_max]
  --<|

  --/|Apply damage via ScriptCards !t (Single — hit bar only).
  --:ApplyDamageScriptCardsSingle|Parameters are tokenid;bar#;tempHPbar;amount;display (0 or 1);allow overheal (0 or 1);allow negative hp (0 or 1)
  --=applyValue|[%4%]
  --=newValue|[*[%1%]:t-bar[%2%]_value] + [$applyValue]
  --?"X[&AllowNegativeHP]" -ne "X1" -and [$newValue] -lt 0|=newValue;0
  --?"X[%6%]" -ne "X1" -and [$newValue] -gt [*[%1%]:t-bar[%2%]_max]|=newValue;[*[%1%]:t-bar[%2%]_max]
  --?"X[%5%]" -eq "X1"|+Applying;[%4%] HP to [*[%1%]:t-name]
  --!t:[%1%]|bar[%2%]_value:[$newValue.Raw]
  --<|

  --/|Apply damage via ScriptCards !t TempHP path. Temp bar then HP. Same math as Alterbars TempHP.
  --:ApplyDamageScriptCardsTempHP|Parameters are tokenid;bar#;tempHPbar;amount;display (0 or 1);allow overheal (0 or 1);allow negative hp (0 or 1)
  -->ADJUST_DAMAGE_FOR_TEMP_HP|[%1%];[%3%];[%4%]
  --?"[&_tempBarChanged]" -eq "1"|-->SYNC_TEMP_HP_BAR|[%1%];[%3%];[&_tempNewValue]
  --=tempHpRemainToMain|[&_tempAdjAmount]
  --?"X[$tempHpRemainToMain]" -eq "X"|=tempHpRemainToMain;0
  --?"[$tempHpRemainToMain.Raw]" -eq 0|<
  --=_applyValue|[$tempHpRemainToMain.Raw]
  -->_ComputeClampedHP|[%1%];[%2%];[%6%]
  --?"X[%5%]" -eq "X1"|+Applying;[$tempHpRemainToMain.Raw] HP to [*[%1%]:t-name]
  --!t:[%1%]|bar[%2%]_value:[$_newValue.Raw]
  --<|

  --/|Token-mod Single — relative HP delta (listen_to_tokenmod). Clamp only when AllowNegativeHP is not 1.
  --:ApplyDamageTokenmodSingle|Parameters are tokenid;bar#;tempHPbar;amount;display (0 or 1);allow overheal (0 or 1);allow negative hp (0 or 1)
  --=applyValue|[%4%]
  --=StartHP|[*[%1%]:t-bar[%2%]_value]
  --=newValue|[$StartHP] + [$applyValue]
  --?"X[&AllowNegativeHP]" -ne "X1" -and [$newValue] -lt 0|=newValue;0
  --?"X[%6%]" -ne "X1" -and [$newValue] -gt [*[%1%]:t-bar[%2%]_max]|=newValue;[*[%1%]:t-bar[%2%]_max]
  --=hpDelta|[$newValue] - [$StartHP]
  --?"[$hpDelta]" -eq "0"|<
  --?"X[%5%]" -eq "X1"|+Applying;[%4%] HP to [*[%1%]:t-name]
  --?[$hpDelta] -lt 0|[
   --@token-mod|_ignore-selected _ids [%1%] _set bar[%2%]_value|[$hpDelta.Raw]
   --<|
  --]|
  --@token-mod|_ignore-selected _ids [%1%] _set bar[%2%]_value|+[$hpDelta.Raw]
  --<|

  --/|Token-mod TempHP — relative temp then HP deltas (listen_to_tokenmod). No SyncTempHPSheet on this path.
  --:ApplyDamageTokenmodTempHP|Parameters are tokenid;bar#;tempHPbar;amount;display (0 or 1);allow overheal (0 or 1);allow negative hp (0 or 1)
  --/|Gosub amount is a roll object: use Total when non-zero, else Raw.
  --&TempHPDrained|0
  --=applyValue|[%4%]
  --=camDmgTotal|[$applyValue.Total]
  --=camDmgRaw|[$applyValue.Raw]
  --?"[$camDmgTotal.Raw]" -ne "0"|=camDmgResolved;[$camDmgTotal.Raw]
  --?"[$camDmgTotal.Raw]" -eq "0"|=camDmgResolved;[$camDmgRaw.Raw]
  --=_applyValue|[$camDmgResolved.Raw]
  --/|Damage-only — negative amounts from CAM_ApplyDamageOrHealing (positive healing never enters here).
  --=StartHP|[*[%1%]:t-bar[%2%]_value]
  -->ReadTokenTempHP|[%1%];[%3%];_tokTempHPRead
  --=TempHP|[&_tokTempHPRead]
  --?"X[$TempHP]" -eq "X"|=TempHP;0
  --~damageValue|math;abs;[$_applyValue]
  --?"X[$TempHP]" -nei "X" -and [$TempHP] -gt 0 -and [$TempHP] -ge [$damageValue]|[
   --=newTempHP|[$TempHP]-[$damageValue]
   --?"X[%5%]" -eq "X1"|+Applying;[%4%] HP to [*[%1%]:t-name]
   --/|Temp-only: relative delta on temp bar only (do not touch HP bar).
   --@token-mod|_ignore-selected _ids [%1%] _set bar[%3%]_value|-[$damageValue.Raw]
   --^ApplyDamageTokenmodTempHP_Done|
  --]|
  --?"X[$TempHP]" -nei "X" -and [$TempHP] -gt 0 -and [$TempHP] -lt [$damageValue]|[
   --=_applyValue|[$_applyValue] + [$TempHP]
   --&TempHPDrained|[$TempHP.Raw]
   --=_newValue|[$StartHP] + [$_applyValue]
   --^_ApplyHPDamageTokenmod|
  --]|
  --=_newValue|[$StartHP] + [$_applyValue]
  --:_ApplyHPDamageTokenmod|
  --=hpDelta|[$_applyValue]
  --?"X[&AllowNegativeHP]" -ne "X1" -and [$_newValue] -lt 0|[
   --=_newValue|0
   --=hpDelta|[$StartHP] {NEGATE}
  --]|
  --?"X[%6%]" -ne "X1" -and [$_newValue] -gt [*[%1%]:t-bar[%2%]_max]|[
   --=_newValue|[*[%1%]:t-bar[%2%]_max]
   --=hpDelta|[$_newValue] - [$StartHP]
  --]|
  --=TempHPDrainedNum|[&TempHPDrained]
  --?"[$hpDelta]" -eq "0" -and [$TempHPDrainedNum] -eq 0|[
   --^ApplyDamageTokenmodTempHP_Done|
  --]|
  --?"X[%5%]" -eq "X1"|+Applying;[%4%] HP to [*[%1%]:t-name]
  --?"[$hpDelta]" -ne "0" -and [$TempHPDrainedNum] -gt 0|[
   --?[$hpDelta] -lt 0|[
    --@token-mod|_ignore-selected _ids [%1%] _set bar[%2%]_value|[$hpDelta.Raw] bar[%3%]_value|-[$TempHPDrained.Raw]
    --^ApplyDamageTokenmodTempHP_Done|
   --]|
   --@token-mod|_ignore-selected _ids [%1%] _set bar[%2%]_value|+[$hpDelta.Raw] bar[%3%]_value|-[$TempHPDrained.Raw]
   --^ApplyDamageTokenmodTempHP_Done|
  --]|
  --?"[$hpDelta]" -ne "0"|[
   --?[$hpDelta] -lt 0|[
    --@token-mod|_ignore-selected _ids [%1%] _set bar[%2%]_value|[$hpDelta.Raw]
    --^ApplyDamageTokenmodTempHP_Done|
   --]|
   --@token-mod|_ignore-selected _ids [%1%] _set bar[%2%]_value|+[$hpDelta.Raw]
   --^ApplyDamageTokenmodTempHP_Done|
  --]|
  --@token-mod|_ignore-selected _ids [%1%] _set bar[%3%]_value|-[$TempHPDrained.Raw]
  --:ApplyDamageTokenmodTempHP_Done|
  --<|

  --/|AlterBars Single. Relative delta on hit bar (clamped). Pass actual bar change not raw signed amount only.
  --:ApplyDamageAlterbarsSingle|Parameters are tokenid;bar#;tempHPbar;amount;display (0 or 1);allow overheal (0 or 1);allow negative hp (0 or 1)
  --=StartHP|[*[%1%]:t-bar[%2%]_value]
  --=applyValue|[%4%]
  --=newValue|[$StartHP] + [$applyValue]
  --?"X[&AllowNegativeHP]" -ne "X1" -and [$newValue] -lt 0|=newValue;0
  --?"X[%6%]" -ne "X1" -and [$newValue] -gt [*[%1%]:t-bar[%2%]_max]|=newValue;[*[%1%]:t-bar[%2%]_max]
  --=hpAlterDelta|[$newValue] - [$StartHP]
  --?"[$hpAlterDelta.Raw]" -eq 0|<
  --?"X[%5%]" -eq "X1"|+Applying;[$hpAlterDelta.Raw] HP to [*[%1%]:t-name]
  --@alter|_target|[%1%] _bar|[%2%] _amount|[$hpAlterDelta.Raw] _show|none
  --<|

  --/|AlterBars TempHP — temp bar delta then relative HP amount (same temp math as ScriptCards TempHP).
  --:ApplyDamageAlterbarsTempHP|Parameters are tokenid;bar#;tempHPbar;amount;display (0 or 1);allow overheal (0 or 1);allow negative hp (0 or 1)
  -->ADJUST_DAMAGE_FOR_TEMP_HP|[%1%];[%3%];[%4%]
  --?"[&_tempBarChanged]" -eq "1"|[
   --?"[$_tempAlterDeltaRoll.Raw]" -ne "0"|[
    --@alter|_target|[%1%] _bar|[%3%] _amount|[$_tempAlterDeltaRoll.Raw] _show|none
   --]|
   --?"X[*[%1%]:character_id]" -ne "X"|[
    --=tempNewSheet|[&_tempNewValue]
    --!a:[*[%1%]:character_id]|!hp_temp:[$tempNewSheet.Raw]
   --]|
  --]|
  --=tempHpRemainToMain|[&_tempAdjAmount]
  --?"X[$tempHpRemainToMain]" -eq "X"|=tempHpRemainToMain;0
  --?"[$tempHpRemainToMain.Raw]" -eq 0|<
  --=StartHP|[*[%1%]:t-bar[%2%]_value]
  --=applyValue|[$tempHpRemainToMain.Raw]
  --=newValue|[$StartHP] + [$applyValue]
  --?"X[&AllowNegativeHP]" -ne "X1" -and [$newValue] -lt 0|=newValue;0
  --?"X[%6%]" -ne "X1" -and [$newValue] -gt [*[%1%]:t-bar[%2%]_max]|=newValue;[*[%1%]:t-bar[%2%]_max]
  --=hpAlterDelta|[$newValue] - [$StartHP]
  --?"[$hpAlterDelta.Raw]" -eq 0|<
  --?"X[%5%]" -eq "X1"|+Applying;[$hpAlterDelta.Raw] HP to [*[%1%]:t-name]
  --@alter|_target|[%1%] _bar|[%2%] _amount|[$hpAlterDelta.Raw] _show|none
  --<|

  --/|Just a dummy routine that doesn't do anything, but it is easier to do it this way than adding logic to see if we are
  --/|skipping applying damage in the main routine.
  --:DontApplyDamage|
  --<|

  --:SHOW_DAMAGE_BUTTONS|DamageAmount
  --=FullDamage|[%4%]
  --=HalfDamage|[%4%] {NEGATE} \\ 2 {NEGATE}
  --=QuarterDamage|[%4%] {NEGATE} \\ 4 {NEGATE}
  --=HealDamage|[%4%] {NEGATE}
  --?[&whisperDamageButtonsToDM] -eq 1|[
    --*|[c][rbutton]Full ([$FullDamage.Raw])::APPLY_DAMAGE;[$FullDamage.Raw][/rbutton] | [rbutton]1/2 ([$HalfDamage.Raw])::APPLY_DAMAGE;[$HalfDamage.Raw][/rbutton] | [rbutton]1/4 ([$QuarterDamage.Raw])::APPLY_DAMAGE;[$QuarterDamage.Raw][/rbutton] &nbsp;&nbsp;|&nbsp;&nbsp; [rbutton]Heal::APPLY_DAMAGE;[$HealDamage.Raw][/rbutton][/c]
  --]|[
    --+|[c][rbutton]Full::APPLY_DAMAGE;[$FullDamage.Raw][/rbutton] | [rbutton]1/2::APPLY_DAMAGE;[$HalfDamage.Raw][/rbutton] | [rbutton]1/4::APPLY_DAMAGE;[$QuarterDamage.Raw][/rbutton] &nbsp;&nbsp;|&nbsp;&nbsp; [rbutton]Heal::APPLY_DAMAGE;[$HealDamage.Raw][/rbutton][/c]      
  --]|
  --<|

  --/|Reentry to apply damage or healing to selected tokens (damagebuttons). Uses CAM_ApplyDamageOrHealing for heal vs damage and temp HP.
  --:APPLY_DAMAGE|Amount
  -->CAM_SetDamageApplyRoutines|
  --?[&whisperDamageButtonResultsToDM] -eq 1|[
    --#whisper|gm
    --#title|Damage Applied
  --]|[
    --#whisper|nobody
    --#title|Should never show
  --]|
  --~tokenCount|array;getlength;SC_SelectedTokens
  --=tokenCount|[&tokenCount] - 1
  --%loop|0;[$tokenCount.Raw]
    --&thisToken|[@SC_SelectedTokens([&loop])]
    --+Applying|[&reentryval] HP to [*[&thisToken]:t-name]
    -->CAM_ApplyDamageOrHealing|[&thisToken];[&hitPointsBar];[&tempHPBar];[&reentryval];0;0;1
  --%|
  --X|

  --:FIND_REPEATING_RESOURCE|character_id;resourceName;resourceReturnNameStringVariable;ResourceReturnValueStringVariable;ResouceCurrentValue
    --?"[%2%]" -eq "[*[%1%]:class_resource_name]"|_IsResourceClass
    --?"[%2%]" -eq "[*[%1%]:other_resource_name]"|_IsResourceOther
    --Rfirst|[%1%];repeating_resource
    --:_ResourceLoop|
