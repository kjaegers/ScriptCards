--:RESET_RESOURCES_ON_REST|CharacterID;RestType (S or L);Report? (y or n)
--&_LIB_REST_TYPE|UNKNOWN
--?"[%2%]" -eq "L" -or "[%2%]" -eq "l"|>RESET_RESOURCES_ON_REST;[%1%];s;[%3%]
--?"[%2%]" -eq "S" -or "[%2%]" -eq "s"|&_LIB_REST_TYPE;short
--?"[%2%]" -eq "L" -or "[%2%]" -eq "l"|&_LIB_REST_TYPE;long
--?"[&_LIB_REST_TYPE]" -eq "UNKNOWN"|<

--?"[*[%1%]:class_resource_reset]" -ne "[&_LIB_REST_TYPE]"|_LibAMA_RESET_SKIPCLASS
--?"[*[%1%]:class_resource]" -eq "[*[%1%]:class_resource^]"|_LibAMA_RESET_SKIPCLASS
--!a:[%1%]|class_resource:[*[%1%]:class_resource^]
--?"[%3%]" -eq "y"|+;Resource [*[%1%]:class_resource_name] reset to [*[%1%]:class_resource^].
--:_LibAMA_RESET_SKIPCLASS|
--?"[*[%1%]:other_resource_reset]" -ne "[&_LIB_REST_TYPE]"|_LibAMA_RESET_SKIPOTHER
--?"[*[%1%]:other_resource]" -eq "[*[%1%]:other_resource^]"|_LibAMA_RESET_SKIPOTHER
--!a:[%1%]|other_resource:[*[%1%]:other_resource^]
--?"[%3%]" -eq "y"|+;Resource [*[%1%]:other_resource_name] reset to [*[%1%]:other_resource^].
--:_LibAMA_RESET_SKIPOTHER|

--Rfirst|[%1%];repeating_resource
--?"[*R:resource_left_name]" -eq "NoRepeatingAttributeLoaded"|<
--:_LibAMA_RESET_REPEAT|
--?"[*R:resource_left_reset]" -ne "[&_LIB_REST_TYPE]"|_LIB_AMA_RESET_SKIP_LEFT
--?"[*R:resource_left]" -eq "[*R:resource_left^]"|_LIB_AMA_RESET_SKIP_LEFT
--!a:[%1%]|[*R>resource_left]:[*R:resource_left^] 
--?"[%3%]" -eq "y"|+;Resource [*R:resource_left_name] reset to [*R:resource_left^].
--:_LIB_AMA_RESET_SKIP_LEFT|
--?"[*R:resource_right_reset]" -ne "[&_LIB_REST_TYPE]"|_LIB_AMA_RESET_SKIP_RIGHT
--?"[*R:resource_right]" -eq "[*R:resource_right^]"|_LIB_AMA_RESET_SKIP_RIGHT
--!a:[%1%]|[*R>resource_right]:[*R:resource_right^]
--?"[%3%]" -eq "y"|+;Resource [*R:resource_right_name] reset to [*R:resource_right^].
--:_LIB_AMA_RESET_SKIP_RIGHT|
--Rnext|
--?"[*R:resource_left_name]" -ne "NoRepeatingAttributeLoaded"|_LibAMA_RESET_REPEAT
--<|
