  --:EXEC_PC_TRAIT|
  --#whisper|self
  --#emotestate|visible
  --&trait_rowid|[&reentryval]
  --Rbysectionid|[*S:character_id];repeating_traits;[&trait_rowid]
  --?"[*R:name]" -eq "NoRepeatingAttributeLoaded"|[
   --&trait_name|[&reentryval]
   --&trait_name|[&trait_name(replace,-!-!-,;)]
   --&trait_name|[&trait_name(replace,-!lpar!-,(,)]
