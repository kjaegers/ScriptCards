  --:BUILD_SPELL_BUTTON_LIST|Character ID;Repeating_section_name;repeating field for name;reentrant point;section header;mule char name/id;spell level

    --?"[&trackPCSpellSlots]" -eq "1"|DO_BUILD_SPELL_BUTTON_LIST
    --&AM_CACHED_BUTTON_LIST|[*[%1%]:5ECAM_CACHE_[%5%]_[%7%]]
    --?"[&AM_CACHED_BUTTON_LIST]" -eq "undefined"|DO_BUILD_SPELL_BUTTON_LIST
    --?"[&AM_CACHED_BUTTON_LIST]" -eq ""|DO_BUILD_SPELL_BUTTON_LIST
    --&AM_CACHED_BUTTON_LIST|[&AM_CACHED_BUTTON_LIST(replaceall,!#!,:)]
    --&AM_CACHED_BUTTON_LIST|[&AM_CACHED_BUTTON_LIST(replaceall,!$!,;)]
    --&AM_CACHED_BUTTON_LIST|[&AM_CACHED_BUTTON_LIST(replaceall,!@!,|)]
    --?"[&AM_CACHED_BUTTON_LIST]" -eq ""|AM_SPELL_BUTTON_LIST_NOTHING
    --?"[&AM_CACHED_BUTTON_LIST]" -eq "[&CAM_SectionSpacer]"|AM_SPELL_BUTTON_LIST_NOTHING
    -->CAM_EMIT_SECTION|[%5%];AM_CACHED_BUTTON_LIST
    --<|

    --:DO_BUILD_SPELL_BUTTON_LIST|
    --&_buildSpellLevel|[%7%]
    --&slotString|
    --&RitualslotString|
    --&LevelString|[&_buildSpellLevel]
    --?"[%7%]" -eq 0|&LevelString; 
    --?"[%7%]" -eq 0|BEGIN_BUILDING_SPELL_BUTTONS
    --?"[&UseAMAShadowdarkSystem]" -eq "1" -and "[*S:class]" -eq "Wizard"|BEGIN_BUILDING_SPELL_BUTTONS
    --?"[%7%]" -gt 0 -and "[&WarlockLevel]" -gt 0"|>BUILD_WARLOCK_SPELL_SLOT_STRING;slotString;RitualslotString
    --?"[%7%]" -gt 0 -and "[&WarlockLevel]" -eq 0"|>BUILD_SLOT_LIST;[%7%];slotString;
    --?"[%7%]" -gt 0 -and "[&WarlockLevel]" -eq 0"|>BUILD_SLOT_LIST;[%7%];RitualslotString;Yes
    --&CamBeaconQueryString|
    --?"[&CamBeaconMarkerName]" -eq "0"|[
     --&CamBeaconQueryString||[&QB]Beacon Of Hope|No|Yes[&QE]
    --]|
    --:BEGIN_BUILDING_SPELL_BUTTONS|
    --~|hashtable;fromrepeatingsection;[%1%];[%2%];[%3%];BuiltButtonHash
    --~|array;fromkeys;Hash_Keys;BuiltButtonHash
    --?"[@Hash_Keys(length)]" -eq "undefined array"|AM_SPELL_BUTTON_LIST_NOTHING
    --?[@Hash_Keys(length)] -eq 0|AM_SPELL_BUTTON_LIST_NOTHING
    --~|array;define;HashList
    --%loop|foreach;Hash_Keys
      --?"[&loop]" -inc "_sectionid"|[
       --&_spellHashName|[&loop(replace,_sectionid,)]
       --?"[&_spellHashName]" -eq ""|spellHashLoopNext
       --?"[&_spellHashName]" -eq "false"|spellHashLoopNext
       --?"X[&_spellHashName]" -eq "Xfalse"|spellHashLoopNext
       --~|array;add;HashList;[&_spellHashName]
       --:spellHashLoopNext|
      --]|
    --%|
    --?"[@HashList(length)]" -lt 1|AM_SPELL_BUTTON_LIST_NOTHING
    --~|array;sort;HashList

    --&AM_BUTTON_LIST|

    --/|Remaining slots for this spell level once per section. Used by per-spell filter below.
    --&_spellBtnSlotsAtLevel|0
    --?"[&_buildSpellLevel]" -eq 0|PC_SPELL_BTN_SLOTS_READ_DONE
    --?[*[%1%]:npc] -eq 1|PC_SPELL_BTN_SLOTS_READ_DONE
    --?[&trackPCSpellSlots] -eq 0|PC_SPELL_BTN_SLOTS_READ_DONE
    --?"[&WarlockLevel]" -gt 0"|[
     -->GET_WARLOCK_PACT_SLOT_LEVEL|_spellBtnPactLvl
     -->GET_AVAILABLE_SPELL_SLOTS|[&_spellBtnPactLvl];_spellBtnSlotsAtLevel
    --]|[
     -->GET_AVAILABLE_SPELL_SLOTS|[&_buildSpellLevel];_spellBtnSlotsAtLevel
    --]|
    --=spellBtnSlotsAtLevelNum|[&_spellBtnSlotsAtLevel]
    --?"X[$spellBtnSlotsAtLevelNum]" -eq "X"|=spellBtnSlotsAtLevelNum;0
    --:PC_SPELL_BTN_SLOTS_READ_DONE|

    --%spellloop|foreach;HashList
      --/\|Loop: [&spellloop]
      --?"[&spellloop]" -eq ""|SPELL_BUTTON_END_GENERATE
      --?"[&spellloop]" -eq "false"|SPELL_BUTTON_END_GENERATE
      --?"X[&spellloop]" -eq "Xfalse"|SPELL_BUTTON_END_GENERATE
      --?"[&spellloop]" -eq "ArrayError"|SPELL_BUTTON_END_GENERATE
      --?"[&spellloop]" -eq "undefined"|SPELL_BUTTON_END_GENERATE

      --?[*[%1%]:npc] -eq 1 -and "[&skipNPCPrepCheck]" -eq "1"|SKIP_PREP_CHECK
      --?[&skipPreppedSpellsCheck] -eq 1|SKIP_PREP_CHECK
      --?"[%7%]" -eq 0|SKIP_PREP_CHECK   
      --?"[&SorcererLevel]" -gt 0 -or "[&WarlockLevel]" -gt 0|SKIP_PREP_CHECK
      --?"[:BuiltButtonHash("[&spellloop]_spellprepared")]" -eq "1" -or "[:BuiltButtonHash("[&spellloop]_spellritual")]" -eq "Yes"|SKIP_PREP_CHECK
      --^SPELL_BUTTON_END_GENERATE|
      --:SKIP_PREP_CHECK|
      --?"[&UseAMAShadowdarkSystem]" -eq "1" -and "[*S:class]" -eq "Wizard" -and "[:BuiltButtonHash("[&spellloop]_innate")]" -eq 1|SPELL_BUTTON_END_GENERATE
      --&targetString|[&TB]target|token_id}
      --&CamSpellReentryTrailer||[&LevelString][&spellloop]
      --&DisplayName|[&spellloop]
      --&DisplayName|[&DisplayName(totitlecase)]
      --/\|DisplayName [&DisplayName]
      --&thisSlotString|[&slotString]
      --?"[:BuiltButtonHash("[&spellloop]_spellritual")]" -ne "Yes"|SPELL_BUTTON_LIST_NOT_RITUAL
      --&thisSlotString|[&RitualslotString]
      --&DisplayName|+ [R]
      --:SPELL_BUTTON_LIST_NOT_RITUAL|
      --?"[:BuiltButtonHash("[&spellloop]_spellcastingtime")]" -inc "reaction"|&DisplayName;+ [RA]
      --?"[:BuiltButtonHash("[&spellloop]_spellcastingtime")]" -inc "bonus"|&DisplayName;+ [BA]
      --?"[:BuiltButtonHash("[&spellloop]_spellconcentration")]" -inc "concentration=1"|&DisplayName;+ [C]
      --/|PC slot filter (per spell): at 0 slots for this level, hide unless ritual [R].
      --?"[&_buildSpellLevel]" -eq 0|AM_SPELL_BUTTON_SKIP_SLOT_INFO 
      --?[*[%1%]:npc] -eq 1|AM_SPELL_BUTTON_SKIP_SLOT_INFO
      --?[&trackPCSpellSlots] -eq 0|AM_SPELL_BUTTON_SKIP_SLOT_INFO
      --?"[$spellBtnSlotsAtLevelNum.Raw]" -ne 0|AM_SPELL_BUTTON_SKIP_SLOT_INFO
      --?"[:BuiltButtonHash("[&spellloop]_spellritual")]" -eq "Yes"|AM_SPELL_BUTTON_SKIP_SLOT_INFO
      --^SPELL_BUTTON_END_GENERATE|
      --:AM_SPELL_BUTTON_SKIP_SLOT_INFO|
      --~testName|string;replaceall; ;-;[&spellloop]
      --~testMule|system;findability;[&spellmulename];[&testName]
      --?[&testMule] -ne "AbilityNotFound"|SPELL_BUTTON_MULE
      --?"[:BuiltButtonHash("[&spellloop]_spelloutput")]" -eq ATTACK|SPELL_BUTTON_GENERATE_WITH_TARGET
      --?"[:BuiltButtonHash("[&spellloop]_spellhealing")]" -ne ""|SPELL_BUTTON_GENERATE_WITH_TARGET
      -->CAM_SpellBtnApplyBeaconQuery|[&spellloop]
      --&AM_BUTTON_LIST|+[rbutton][&DisplayName]::[%4%];[&LevelString][&spellloop]|NONE[&thisSlotString][&thisBeaconString][&CamSpellReentryTrailer][/rbutton][&SPACE]
      --^SPELL_BUTTON_END_GENERATE|
      --:SPELL_BUTTON_GENERATE_WITH_TARGET|
      -->CAM_SpellBtnApplyBeaconQuery|[&spellloop]
      --&AM_BUTTON_LIST|+[rbutton][&DisplayName]::[%4%];[&LevelString][&spellloop]|[&targetString][&thisSlotString][&thisBeaconString][&CamSpellReentryTrailer][/rbutton][&SPACE]
      --^SPELL_BUTTON_END_GENERATE|
      --:SPELL_BUTTON_MULE|
      --&AM_BUTTON_LIST|+[button][&DisplayName]::~[&spellmulename]|[&testName][/button][&SPACE]
      --:SPELL_BUTTON_END_GENERATE|
    --%|
      
    --/|If the list is empty, skip the output|
    --?"[&AM_BUTTON_LIST]" -eq ""|AM_SPELL_BUTTON_LIST_NOTHING
    --?"[&AM_BUTTON_LIST]" -eq "[br]"|AM_SPELL_BUTTON_LIST_NOTHING

  --?"[&trackPCSpellSlots]" -ne "1"|[
   --&cacheList|[&AM_BUTTON_LIST(replaceall,:,!#!)]
   --&cacheList|[&cacheList(replaceall,;,!$!)]
   --&cacheList|[&cacheList(replaceall,|,!@!)]
   --!a:[%1%]|!5ECAM_CACHE_[%5%]_[%7%]:[&cacheList]
  --]|

    -->CAM_EMIT_SECTION|[%5%];AM_BUTTON_LIST
    --<|
    --:AM_SPELL_BUTTON_LIST_NOTHING|
