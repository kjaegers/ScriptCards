  -->CAM_EMIT_SECTION|[%5%];AM_CACHED_BUTTON_LIST
  --:BUILD_BUTTON_LIST_CACHE_SKIP|
  --<|

  --/|Title and buttons in one chat row with [BR] only. Two output lines add an extra blank row.

  --:DO_BUILD_BUTTON_LIST|
  --~|hashtable;fromrepeatingsection;[%1%];[%2%];[%3%];BuiltButtonHash
  --~|array;fromkeys;Hash_Keys;BuiltButtonHash
  --?"[@Hash_Keys(length)]" -eq "undefined array"|AM_BUTTON_LIST_NOTHING
  --?[@Hash_Keys(length)] -eq 0|AM_BUTTON_LIST_NOTHING
  --&AM_BUTTON_LIST|
  --%loop|foreach;Hash_Keys
    --?"[&loop]" -inc "_sectionid"|AM_LIST_NEXT_ROW|AM_LIST_CONTINUE
    --:AM_LIST_NEXT_ROW|
    --&DisplayName|[&loop(replace,_sectionid,)]
    --?"[&DisplayName]" -eq ""|AM_LIST_CONTINUE
    --?"[&DisplayName]" -eq "false"|AM_LIST_CONTINUE
    --&RowSectionId|[:BuiltButtonHash("[&DisplayName]_sectionid")]
    --?"[&RowSectionId]" -eq ""|&RowSectionId;[:BuiltButtonHash("[&loop]")]
    --&ActionName|[&DisplayName(replace,;,-!-!-)]
    --&ActionName|[&ActionName(replace,(,-!lpar!-)]
    --&ActionName|[&ActionName(replace,),-!rpar!-)]
    --&ActionName|[&ActionName(replace,+,-!plus!-)]
    --/|5E SPECIFIC START 
    --?"[&DisplayName(contains,Multiattack)]" -eq 1|>SHOW_MULTIATTACK;[:BuiltButtonHash("[&DisplayName]_description")]
    --?"[&DisplayName(contains,Multiattack)]" -eq 1|AM_LIST_CONTINUE
    --?"[%8%]" -eq "0"|SKIP_BUTTON_LIST_SPELL_CHECK
    --&keepSpell|N
    --&spellSuffix|
    -->CHECK_SPELLS_TO_KEEP|"[&DisplayName]";keepSpell;spellSuffix
    --&spellLink|[:BuiltButtonHash("[&DisplayName]_spelldesc_link")]
    --?"[&spellLink]" -eq ""|&spellLink;undefined
    --?"[&spellLink]" -ne "undefined" -and "[&keepSpell]" -eq "N"|AM_LIST_CONTINUE
    --:SKIP_BUTTON_LIST_SPELL_CHECK|
    --/|5E SPECIFIC END

    --?"[%6%]" -eq "none"|AM_LIST_SKIP_MULE_CHECK
    --~testName|string;replaceall; ;-;[&DisplayName]
    --~testMule|system;findability;[%6%];[&testName]
    --?"[&testMule]" -eq "AbilityNotFound"|AM_LIST_SKIP_MULE_CHECK
    --&_muleBtnPiece|[button][&DisplayName(totitlecase)]::~[%6%]|[&testName][/button][&SPACE]
    --&AM_BUTTON_LIST|+[&_muleBtnPiece]
    --^AM_LIST_CONTINUE|
    --:AM_LIST_SKIP_MULE_CHECK|
    --&actionAttackFlag|[:BuiltButtonHash("[&DisplayName]_attack_flag")]
    --?"[%4%]" -eq "EXEC_PC_ATTACK"|AM_LIST_PC_ATTACK_TARGET
    --?"[%4%]" -eq "EXEC_NPC_ACTION"|AM_LIST_ATTACK_TARGET
    --?"[%4%]" -inc "EXEC_NPC"|AM_LIST_NPC_ATTACK_SUFFIX
    --^AM_LIST_BUILD_RBUTTON|
    --:AM_LIST_PC_ATTACK_TARGET|
    --&actionTargetSuffix|[&TB]target|token_id}
    --?"[&actionAttackFlag]" -eq "0"|AM_LIST_PC_NO_TARGET|AM_LIST_BUILD_RBUTTON
    --?"[&actionAttackFlag]" -eq 0|AM_LIST_PC_NO_TARGET|AM_LIST_BUILD_RBUTTON
    --^AM_LIST_BUILD_RBUTTON|
    --:AM_LIST_NPC_ATTACK_SUFFIX|
    --&actionTargetSuffix|NONE
    --&actionToHit|[:BuiltButtonHash("[&DisplayName]_attack_tohit")]
    --?"[&actionAttackFlag]" -inc "on"|AM_LIST_ATTACK_TARGET
    --?"[&actionAttackFlag]" -eq "1"|AM_LIST_ATTACK_TARGET
    --?"X[&actionToHit]" -ne "X" -and "[&actionToHit]" -ne "" -and "[&actionToHit]" -ne "undefined"|AM_LIST_ATTACK_TARGET
    --^AM_LIST_BUILD_RBUTTON|
    --:AM_LIST_ATTACK_TARGET|
    --&actionTargetSuffix|[&TB]target|token_id}
    --^AM_LIST_BUILD_RBUTTON|
    --:AM_LIST_PC_NO_TARGET|
    --&actionTargetSuffix|NONE
    --:AM_LIST_BUILD_RBUTTON|
    --/|Payload is encoded action name for Rfind on exec. NPC rows prefer RID when names have odd punctuation. Legacy chat buttons decode via PC_ATK_DECODE_RID.
    --&PcAttackPayload|[&ActionName]
    --?"[%4%]" -inc "EXEC_NPC"|[
     --?"X[&RowSectionId]" -ne "X" -and "[&RowSectionId]" -ne "" -and "[&RowSectionId]" -ne "undefined"|&PcAttackPayload;RID[&RowSectionId]
    --]|
    --:AM_LIST_PAYLOAD_DONE|
    --&AM_BUTTON_LIST|+[rbutton][&DisplayName(totitlecase)]::[%4%];[&PcAttackPayload]|[&actionTargetSuffix][/rbutton][&SPACE]
    --:AM_LIST_CONTINUE|
  --%|
  --?"[&AM_BUTTON_LIST]" -eq ""|AM_BUTTON_LIST_NOTHING
  -->MULE_BTN_CACHE_ESC|AM_BUTTON_LIST;cacheList
  --?"[%5%]" -eq "Attacks and Actions"|AM_LIST_SKIP_CACHE_WRITE
  --?"[%5%]" -eq "Actions"|AM_LIST_SKIP_CACHE_WRITE
  --?"[%5%]" -eq "Bonus Actions"|AM_LIST_SKIP_CACHE_WRITE
  --?"[%5%]" -eq "Reactions"|AM_LIST_SKIP_CACHE_WRITE
  --?"[%5%]" -eq "Legendary Actions"|AM_LIST_SKIP_CACHE_WRITE
