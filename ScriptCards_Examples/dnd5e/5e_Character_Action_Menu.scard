  --?[&skillKey] -eq history|&skillAbiAttr;intelligence_mod
  --?[&skillKey] -eq investigation|&skillAbiAttr;intelligence_mod
  --?[&skillKey] -eq nature|&skillAbiAttr;intelligence_mod
  --?[&skillKey] -eq religion|&skillAbiAttr;intelligence_mod
  --?[&skillKey] -eq deception|&skillAbiAttr;charisma_mod
  --?[&skillKey] -eq intimidation|&skillAbiAttr;charisma_mod
  --?[&skillKey] -eq persuasion|&skillAbiAttr;charisma_mod
  --?[&skillKey] -eq performance|&skillAbiAttr;charisma_mod
  --?[&skillKey] -eq animal_handling|&skillAbiAttr;wisdom_mod
  --?[&skillKey] -eq insight|&skillAbiAttr;wisdom_mod
  --?[&skillKey] -eq medicine|&skillAbiAttr;wisdom_mod
  --?[&skillKey] -eq perception|&skillAbiAttr;wisdom_mod
  --?[&skillKey] -eq survival|&skillAbiAttr;wisdom_mod
  -->Get_Ability_Modifier|[&skillAbiAttr];SkillMod;skillAbiName
  --:SKILL_CHECK_ROLL|
  --&rollEquation|1d20
  --?[&rollType] -eq "Advantage"|&rollEquation;2d20kh1
  --?[&rollType] -eq "Disadvantage"|&rollEquation;2d20kl1
  --=SkillCheck|[&rollEquation] + [$SkillMod.Raw] [&obrac][&skillDisplayName][&cbrac] [&GSKM_VALUES]
  --#title|[&skillDisplayName] Check
  --#leftsub|[*S:character_name]
  --#rightsub|
  --+|[&skillDisplayName] check result: [$SkillCheck]
  --X|

  --:TOOL_CHECK|
  --&whisperTarget|
  --?[*S:npc] -eq 1 -and [&AllNPCActionsToSender] -eq 1|&whisperTarget;self
  --#whisper|[&whisperTarget]
  --~toolInfo|string;split;|;[&reentryval]
  --&tool_base_roll|1d20
  --?[&toolInfo2] e-eq "Advantage"|&tool_base_roll;2d20kh1
  --?[&toolInfo2] e-eq "Disadvantage"|&tool_base_roll;2d20kl1
  --rfind|[*S:character_id];[&toolInfo1];repeating_tool;toolname
  --?"[*R:toolname]" -eq "NoRepeatingAttributeLoaded"|BAD_TOOL_ROLL
  --&toolattr|[*R:toolattr]_mod
  --&toolattr|[&toolattr(tolowercase)]
  --&toolbonus|[*R:toolbonus_base]
  --&toolproftype|[PROF]
  --?"[&toolbonus]" -inc "(pb*2)|&toolproftype;[EXPERT]
  --?"[&toolbonus]" -inc "(pb/2)|&toolproftype;[JACK]
    --~toolbonus|string;replace;(pb*2);[*S:pb] * 2;[&toolbonus]
  --~toolbonus|string;replace;(floor(pb/2));[*S:pb] \ 2;[&toolbonus]
  --?"[&toolbonus]" -eq ""|&toolbonus;[*S:pb]
  --=toolprofbonus|[&toolbonus]
  --?"[&toolattr]" -eq "query_mod"|TOOL_ATTR_QUERY
  --:DO_TOOL_ROLL|
  --&toolattr_display|[
  --&toolattr_display|+[&toolattr(0,3)]
  --&toolattr_display|+]
  --&toolRoll|[&tool_base_roll] + [*S:[&toolattr]] [&toolattr_display(touppercase)] + [$toolprofbonus.Raw] [&toolproftype]
  --=ToolRollResult|[&toolRoll]
  --+[&toolInfo1] Result|[$ToolRollResult]
  --X|
  --:BAD_TOOL_ROLL|
   --+|Bad tool info : [&toolInfo1]
  --X|
  --:TOOL_ATTR_QUERY|
  --#whisper|self
  --+[&toolInfo1]|This tool requires you to select the associated attribute to roll against. Please click the button below to choose.
  --+|[c][rbutton]Choose Attribute::TOOL_ATTR_RETURN;[&QB]Skill to roll?|Strength,strength_mod|Dexterity,dexterity_mod|Constitution,constitution_mod|Intelligence,intelligence_mod|Wisdom,wisdom_mod|Charisma,charisma_mod[&QE][/rbutton][/c]
  --X|
  --:TOOL_ATTR_RETURN|
  --~toolAttrInfo|string;split;|;[&reentryval]
  --&toolattr|[&toolAttrInfo1]
  --&whisperTarget|
  --?[*S:npc] -eq 1 -and [&AllNPCActionsToSender] -eq 1|&whisperTarget;self
  --#whisper|[&whisperTarget]
  --^DO_TOOL_ROLL|
  --?"[*R:toolname]" -eq "NoRepeatingAttributeLoaded"|BAD_TOOL_ROLL
  --X|

  --/|=========================================================================================================
  --/| FUNCTIONS

  --/|The three Find_Active_Global_X_Modifiers functions will loop through the various global modifiers repeating
  --/|sections and construct a line containing the dice roll and description (in square brackets) for each entry
  --/|that has an active flag set. This is set to a variable named after the second parameter and can be appended
  --/|directly to an attack/damage/save roll. Toggle buttons use row ids (Rbysectionid) for names with
  --/|apostrophes or hyphens. Find/append sanitizes GMMModName and builds roll fragments via GMMRollSep
  --/|(no literal # on the same line as &var gosub params and # lines cannot expand &label).

  --:SET_ADV_MODE|
  --&currentAdvantageMode|[&reentryval]
  --^AFTER_ADVMODE_CHANGE|

  --:Find_Active_Global_Attack_Modifiers|character_id;StringVariableToSet
  --&_GAM_Temp| 
  --&_GAMDedupSeen|
  --Rfirst|[%1%];repeating_tohitmod
  --:_GAM_Loop|
  --?"[*R:global_attack_active_flag]" -eq "1"|[
   --&_GAMStgRoll|[*R:global_attack_roll]
   --?"[&_GAMStgRoll]" -ninc "NoRepeatingAttributeLoaded"|[
    --?"[&_GAMStgRoll]" -ne ""|[
     --&GMMModName|[*R:global_attack_name]
     --~GMMModName|string;replace;';’;[&GMMModName]
     --~GMMModName|string;replace;-;‑;[&GMMModName]
     --&GAMDedupKey||[&GMMModName]|
     --?"[&_GAMDedupSeen]" -ninc "[&GAMDedupKey]"|[
      --&_GAMDedupSeen|+ [&GAMDedupKey]
      -->_AddGAM|
     --]|
    --]|
   --]|
  --]|
  --Rnext| 
  --?"[*R:global_attack_name]" -ne "NoRepeatingAttributeLoaded"|_GAM_Loop
  --&[%2%]|[&_GAM_Temp] 
  --<|
  
  --:_AddGAM|
  --&GMMModBracket|[&obrac][&GMMModName][&cbrac]
  --&GMMRollSep|#
  --&GMMGamPiece|
  --&GMMGamPiece|+ + [&_GAMStgRoll][&GMMRollSep] [&GMMModBracket]
  --&_GAM_Temp|+ [&GMMGamPiece]
  --<|

  --:Find_Active_Global_Damage_Modifiers|character_id;StringVariableToSet;isCrit(1=true);StringVar2forResistances
  --&_GDM_Temp| 
  --&_GDM_Temp2|
  --&_GDMDedupSeen|
  --Rfirst|[%1%];repeating_damagemod
  --:_GDM_Loop|
  --?"[*R:global_damage_active_flag]" -eq "1"|[
   --&_GDMStgDice|[*R:global_damage_damage]
   --&_GDMStgCrit|[*R:global_damage_critical_damage]
   --&_GDMStgType|[*R:global_damage_type]
   --&GMMModName|[*R:global_damage_name]
   --~GMMModName|string;replace;';’;[&GMMModName]
   --~GMMModName|string;replace;-;‑;[&GMMModName]
   --&GDMDedupKey||[&GMMModName]|
   --?"[&_GDMDedupSeen]" -ninc "[&GDMDedupKey]"|[
    --&_GDMDedupSeen|+ [&GDMDedupKey]
    --&_GDMStgCritFlag|[%3]
    -->_AddGDM|
   --]|
  --]|
  --Rnext| 
  --?"[*R:global_damage_name]" -ne "NoRepeatingAttributeLoaded"|_GDM_Loop
  --&[%2%]|[&_GDM_Temp] 
  --&[%4%]|[&_GDM_Temp2] 
  --<|
  
  --:_AddGDM|
  --&GMMModBracket|[&obrac][&GMMModName][&cbrac]
  --&GMMRollSep|#
  --&GMMDmgPiece|
  --&GMMDmgPiece|+ + [&_GDMStgDice][&GMMRollSep]
  --?"[&_GDMStgType]" -ne ""|&GMMDmgPiece;+ [&_GDMStgType] damage 
  --&GMMDmgPiece|+ [&GMMModBracket]
  --&_GDM_Temp|+ [&GMMDmgPiece]
  --&GMMCritSuffix| CRIT [&GMMModBracket]
  --?"[&_GDMStgCritFlag]" -eq "1"|&_GDM_Temp;+ + [&_GDMStgCrit] [&GMMCritSuffix]
  --&GMMResPiece|
  --&GMMResPiece|+ + [&_GDMStgDice][&GMMRollSep]
  --?"[&_GDMStgType]" -ne ""|&GMMResPiece;+ [&_GDMStgType] damage 
  --&GMMResPiece|+ [&GMMModBracket][&vbar]
  --&_GDM_Temp2|+ [&GMMResPiece]
  --<|

  --:Find_Active_Global_Save_Modifiers|character_id;StringVariableToSet
  --&[%2%]|
  --&_GSM_Temp|
  --&_GSMDedupSeen|
  --Rfirst|[%1%];repeating_savemod
  --?"[*R:global_save_name]" -eq "NoRepeatingAttributeLoaded"|<
  --:_GSM_Loop|
  --?"[*R:global_save_active_flag]" -eq "1"|[
   --&_GSMStgRoll|[*R:global_save_roll]
   --?"[&_GSMStgRoll]" -ninc "NoRepeatingAttributeLoaded"|[
    --?"[&_GSMStgRoll]" -ne ""|[
     --&GMMModName|[*R:global_save_name]
     --~GMMModName|string;replace;';’;[&GMMModName]
     --~GMMModName|string;replace;-;‑;[&GMMModName]
     --&GSMDedupKey||[&GMMModName]|
     --?"[&_GSMDedupSeen]" -ninc "[&GSMDedupKey]"|[
      --&_GSMDedupSeen|+ [&GSMDedupKey]
      -->_AddGSM|
     --]|
    --]|
   --]|
  --]|
  --Rnext|
  --?"[*R:global_save_name]" -ne "NoRepeatingAttributeLoaded"|_GSM_Loop
  --&[%2%]|[&_GSM_Temp]
  --<|

  --:_AddGSM|
  --&GMMModBracket|[&obrac][&GMMModName][&cbrac]
  --&GMMRollSep|#
  --&GMMSavPiece|
  --&GMMSavPiece|+ + [&_GSMStgRoll][&GMMRollSep] [&GMMModBracket]
  --&_GSM_Temp|+ [&GMMSavPiece]
  --<|
  
  --:Find_Active_Global_Skill_Modifiers|character_id;StringVariableToSet
  --&[%2%]|
  --&_GSKM_Temp|
  --&_GSKMDedupSeen|
  --Rfirst|[%1%];repeating_skillmod
  --?"[*R:global_skill_name]" -eq "NoRepeatingAttributeLoaded"|<
  --:_GSKM_Loop|
  --?"[*R:global_skill_active_flag]" -eq "1"|[
   --&_GSKMStgRoll|[*R:global_skill_roll]
   --?"[&_GSKMStgRoll]" -ninc "NoRepeatingAttributeLoaded"|[
    --?"[&_GSKMStgRoll]" -ne ""|[
     --&GMMModName|[*R:global_skill_name]
     --~GMMModName|string;replace;';’;[&GMMModName]
     --~GMMModName|string;replace;-;‑;[&GMMModName]
     --&GSKMDedupKey||[&GMMModName]|
     --?"[&_GSKMDedupSeen]" -ninc "[&GSKMDedupKey]"|[
      --&_GSKMDedupSeen|+ [&GSKMDedupKey]
      -->_AddGSKM|
     --]|
    --]|
   --]|
  --]|
  --Rnext|
  --?"[*R:global_skill_name]" -ne "NoRepeatingAttributeLoaded"|_GSKM_Loop
  --&[%2%]|[&_GSKM_Temp]
  --<|

  --:_AddGSKM|
  --&GMMModBracket|[&obrac][&GMMModName][&cbrac]
  --&GMMRollSep|#
  --&GMMSklPiece|
  --&GMMSklPiece|+ + [&_GSKMStgRoll][&GMMRollSep] [&GMMModBracket]
