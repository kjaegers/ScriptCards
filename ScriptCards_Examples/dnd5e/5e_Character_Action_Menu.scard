  --/|Sets _muleHyphName, _muleBtnLabel, _mulePipeName, _muleHyphTest. Input: _muleTraitChar, _muleTraitRowName. Colon traits match mule by suffix after ":" only (see settings note).
  --:MULE_TRAIT_RESOLVE|
  --?"[&CamTraceDebug]" -ne "1"|MTR_TRACE_IN_OFF
  --#debug|1
  --:MTR_TRACE_IN_OFF|
  --&_muleShortName|[&_muleTraitRowName]
  --&_muleColonTrait|0
  --?"[&_muleTraitRowName]" -inc ":"|MTR_COLON_SUFFIX
  --^MTR_SEARCH_READY|
  --:MTR_COLON_SUFFIX|
  --&_muleColonTrait|1
  --~_muleShortName|string;after;:;[&_muleTraitRowName]
  --~_muleShortName|string;trim;[&_muleShortName]
  --:MTR_SEARCH_READY|
  --/|Chat button labels must not use HTML colon entities. Use " - " for display colons in mule trait labels.
  --&_muleBtnLabel|[&_muleTraitRowName]
  --&_muleBtnLabel|[&_muleBtnLabel(replaceall,:, - )]
  --&_muleBtnLabel|[&_muleBtnLabel(replaceall,|, - )]
  --~_muleHyphShort|string;replaceall; ;-;[&_muleShortName]
  --~_muleHyphFull|string;replaceall; ;-;[&_muleTraitRowName]
  --&_muleHyphName|[&_muleHyphShort]
  --&_muleHyphTest|AbilityNotFound
  --~|array;objects:character;_pcMuleCidList;[&_muleTraitChar]
  --?"[@_pcMuleCidList(maxindex)]" -eq "undefined array"|MTR_FAIL
  --?"[@_pcMuleCidList(maxindex)]" -lt "0"|MTR_FAIL
  --~_muleHyphTest|system;findability;[&_muleTraitChar];[&_muleHyphShort]
  --?"[&_muleHyphTest]" -eq "AbilityNotFound"|MTR_TRY_CID_SHORT
  --^MTR_USE_HYPH_SHORT|
  --:MTR_USE_HYPH_SHORT|
  --&_muleHyphName|[&_muleHyphShort]
  --^MTR_DONE|
  --:MTR_TRY_CID_SHORT|
  --~_muleHyphTest|system;findability;[@_pcMuleCidList(0)];[&_muleHyphShort]
  --?"[&_muleHyphTest]" -eq "AbilityNotFound"|MTR_SHORT_FAIL
  --^MTR_USE_HYPH_SHORT|
  --:MTR_SHORT_FAIL|
  --?"[&_muleColonTrait]" -eq "1"|MTR_TRY_SPACED_SUFFIX
  --?"[&_muleHyphShort]" -eq "[&_muleHyphFull]"|MTR_FAIL
  --^MTR_TRY_FULL|
  --:MTR_TRY_SPACED_SUFFIX|
  --?"[&_muleShortName]" -eq ""|MTR_FAIL
  --~_muleHyphTest|system;findability;[&_muleTraitChar];[&_muleShortName]
  --?"[&_muleHyphTest]" -eq "AbilityNotFound"|MTR_TRY_CID_SPACED
  --&_muleHyphName|[&_muleHyphShort]
  --^MTR_DONE|
  --:MTR_TRY_CID_SPACED|
  --~_muleHyphTest|system;findability;[@_pcMuleCidList(0)];[&_muleShortName]
  --?"[&_muleHyphTest]" -eq "AbilityNotFound"|MTR_FAIL
  --&_muleHyphName|[&_muleHyphShort]
  --^MTR_DONE|
  --:MTR_TRY_FULL|
  --&_muleHyphName|[&_muleHyphFull]
  --~_muleHyphTest|system;findability;[&_muleTraitChar];[&_muleHyphFull]
  --?"[&_muleHyphTest]" -eq "AbilityNotFound"|MTR_TRY_CID_FULL
  --^MTR_USE_HYPH_FULL|
  --:MTR_USE_HYPH_FULL|
  --&_muleHyphName|[&_muleHyphFull]
  --^MTR_DONE|
  --:MTR_TRY_CID_FULL|
  --~_muleHyphTest|system;findability;[@_pcMuleCidList(0)];[&_muleHyphFull]
  --?"[&_muleHyphTest]" -eq "AbilityNotFound"|MTR_FAIL
  --^MTR_USE_HYPH_FULL|
