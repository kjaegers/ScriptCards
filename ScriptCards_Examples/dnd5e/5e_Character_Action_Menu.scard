  --/|To customize for other games : remove or update the items between 5E SPECIFIC START and 5E SPECIFIC END

  --:BUILD_BUTTON_LIST|Character ID;Repeating_section_name;repeating field for name;reentrant point;section header;mule char name/id;filter out spells
  --/|See if we have a cached version of the button list
  --/|Note that we are not using a cache for NPC Actions, Bonus Actions, Reactions, or Legendary Actions
  --?"[%5%]" -eq "Actions"|DO_BUILD_BUTTON_LIST
  --?"[%5%]" -eq "Bonus Actions"|DO_BUILD_BUTTON_LIST
  --?"[%5%]" -eq "Reactions"|DO_BUILD_BUTTON_LIST
  --?"[%5%]" -eq "Legendary Actions"|DO_BUILD_BUTTON_LIST
  --?"[%5%]" -eq "Attacks and Actions"|DO_BUILD_BUTTON_LIST
  --&AM_CACHED_BUTTON_LIST|[*[%1%]:5ECAM_CACHE_[%5%]]
  --?"[&AM_CACHED_BUTTON_LIST]" -eq "undefined"|DO_BUILD_BUTTON_LIST
  --?"[&AM_CACHED_BUTTON_LIST]" -eq ""|DO_BUILD_BUTTON_LIST
  -->MULE_BTN_CACHE_UNESC|AM_CACHED_BUTTON_LIST;AM_CACHED_BUTTON_LIST
  --?"[&AM_CACHED_BUTTON_LIST]" -eq ""|BUILD_BUTTON_LIST_CACHE_SKIP
