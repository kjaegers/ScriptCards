!script {{
  --/|Script Name : 5E Action Menu
  --/|Version     : 3.8.5
  --/|Requires SC : 2.7.15+
  --/|Author      : Kurt Jaegers
  --/|Modified By : Farsidegallery
  --&CAM_VERSION|3.8.5

  --/|IMPORTANT NOTE: Updating this macro via the in-game editor will cause it to exhibit strange behavior. If you wish
  --/|to make settings changes, make them in an external editor (like NOTEPAD) and copy/paste the whole
  --/|macro into the Roll20 editor.

  --/|Description : This script can be used with either a PC or NPC selected. It will generate an action menu with clickable
  --/|buttons to execute character actions and cast spells. The menu is whispered to the player executing the
  --/|script, while the results of clicking the action buttons are displayed in general chat.

  --/|Includes the optional "ActionMenuAddons" library if it is being used
  +++ActionMenuAddons+++
  -->LibAMA_CHECK_FOR_LIBRARY|UseAddons

  --/|=========================================================================================================
  --/|Settings Area - Customize the behavior of the script here

  --&hitPointsBar|1                 --/|What bar do you use for representing hit points for damage application?
  --&tempHPBar|4                    --/|Token bar # for temporary HP. When UseTempHP is 1, this bar MUST be set on tokens (mandatory).
  --&UseTempHP|0                    --/|1 = deplete tempHPBar before HP. 0 = HP bar only.
  --&AllowNegativeHP|0              --/|1 = HP may go below 0 after damage. 0 = clamp at 0 (overheal still per call param 6).
  --&skipPreppedSpellsCheck|0       --/|If set to 1, show all known spells for PCs. Otherwise (default) show prepared spells only
  --&skipNPCPrepCheck|1             --/|If set to 1 (Default), show all known spells for NPCs. Otherwise show prepared spells only
  --&trackPCSpellSlots|1            --/|If set to 1, available PC spell slots will be tracked/used.
  --&showPCSpellSlotList|1          --/|If set to 1, a section on the menu will show available spell slots (if the character has them)
  --&requireAmmo|1                  --/|If set to 1, ammo will be required for items that have defined ammo. Create a repeating resource matching the Ammo name
  --&showPCSkillsAndSaves|1         --/|Show saving throw and skill check buttons for PCs (set to 0 to hide)
  --&showNPCSkillsAndSaves|1        --/|Show saving throw and skill check buttons for NPCs (set to 0 to hide)
  --&showPCStandardActions|1        --/|Show "Standard Actions" on PCs (if skills and saves are displayed). Set to 0 to hide
  --&showNPCStandardActions|1       --/|Show "Standard Actions" on NPCs (if skills and saves are displayed). Set to 0 to hide
  --&showCharacterSummary|1         --/|Show a line of summary information at the top of the Action Menu. Set to 0 to disable
  --&showGlobalModifierButtons|1    --/|Show global modifiers (attack, damage, save, skill) buttons and allow players to toggle them on/off. Set to 0 to hide
  --&showBonusActionsAndReactions|1 --/|Show Bonus Actions and Reactions for characters. Set to 0 to disable
  --&showPCFeats|1                  --/|Show Traits/Feats for PCs (after Reactions, before Cantrips). Set to 0 to disable
  --&UseResistances|1               --/|If set to 1, damage immunity, vulnerability, and resistance will be included in damage rolls. Resistance calc requires the target character
  --/|                                  sheet (PC or NPC) to have npc_resistances, npc_immunities, and/or npc_vulnerabilities populated with the relevant damage types.                              
  --&UseFailTables|0                --/|If set to 1, natural 1 attack rolls use the rollable fail tables configured below. Any other value uses a simple critical-fail message only.
  --&FailTableMelee|   --/|Full Roll20 rollable table name for melee weapon attack critical fails (natural 1). Leave blank to skip fail tables for melee attacks.
  --&FailTableRanged|  --/|Full Roll20 rollable table name for ranged weapon attack critical fails (natural 1). Leave blank to skip fail tables for ranged attacks.
  --&FailTableSpell|   --/|Full Roll20 rollable table name for spell attack critical fails (natural 1). Leave blank to skip fail tables for spell attacks.
  --&CamBeaconMarkerName|0    --/|Beacon on OGL heals: 0 = slot-style query on spell button (CamBeaconActive). Non-zero = token marker tag like ConcentrationMarkerName.
  --&ConcentrationMarkerName|      --/|Roll20 token marker tag when CAM spells apply concentration. Match your campaign marker (and any external conc trigger you use).
  --&ReportResourceReset|y

  --/|Defaults: 1 for title buttons, 0 for icongraphic and "white-on-black" for icon set. These control how and if some text/images
  --/|            on the Action Menu are replaced with icons from game-icons.net, hosted on my github. In particular, the 
  --/|            TitleButtons setting replaces the emoji's previously used in the title area for settings, short rest, and long rest.
  --/|            the IconsGraphics setting (if 1) replaces "AC", "HP", and "Speed" in the character summary with icons.
  --/|            The type of icons used outside the title area are determiend by the IconsSet - white (white on transparent), 
  --/|            black (black on transparent), or white-on-black.
  --&useGameIconsGraphicsForTitleButtons|1
  --&useGameIconsGraphics|0
  --&gameIconsSet|white-on-black

  --/|If you create a "spell mule" character and put its name here, it's ability list will be checked for
  --/|abilities that match the name of each spell found on PCs. If a match is found, the button that is
  --/|created for that spell will be a sheet-button for that ability instead of a reentrant button back to
  --/|this script for generic processing. This lets you define "special case" macros for non-standard spells.
  --/|The name of the ability on the spell mule needs to exactly match the spell name (case sensitive)
  --&spellmulename|Spell_Mule

  --/|NOTE: Shared Macro Mule functionality is currently broken due to API issues  
  --/|If you create a "shared macro mule" character and put its name here, you can define macros to be used
  --/|generally in your game and a can include a list of macros in a character ability on each character called
  --/|AMLIST that lists each of the mule's abilities that buttons should be created for the in the custom actions section.
  --&sharedmacromulename|Macro_Mule

  --/|If you create a mule character and put its name here, you can define macros for NPC Bonus Actions and Reactions.
  --/|The name matching rules are the same as those for the Spell Mule.
  --&sharednpcmacromulename|NPCAbility_Mule
  
  --/|=========================================================================================================
  --/| PC ABILITY MULE — TRAITS/FEATS WITH A COLON IN THE NAME (read before naming mule abilities)
  --/| Roll20 sheet buttons break when the piped ability name contains ":". For traits like
  --/| "Channel Divinity: Turn Undead", the menu button still shows the full trait name, but the ability on
  --/| this mule must be named ONLY the text after the colon (trim spaces), e.g. "Turn Undead" — not the
  --/| full "Channel Divinity: Turn Undead" string. Matching uses that suffix only.
  --/|=========================================================================================================
  --/|If you create a mule character and put its name here, you can define macros for PC attacks/actions, Feats, and Bonus Action / Reaction trait buttons.
  --/|Set to none to skip mule lookup for PC attacks (sheet-only). Feats, Bonus Actions, and Reactions check this mule first, then NPCAbility_Mule.
  --&pcabilitymulename|PCAbility_Mule

  --/|=========================================================================================================
  --/| More generalized settings. You may not need to change these.

  --&UseNamedCharacterSettings|0        --/|Set to "1" to enable loading of settings information from a saved format named after the character (case sensitive)
  --&sendGmInfo|0                       --/|If this value is set to 1, attack rolls will have the target's numeric AC value hidden
  --&AllNPCActionsToSender|0            --/|If this value is set to 1, NPC actions (except spellcasting) will be whispered to the sender only and not displayed to everyone
  --&damageApplyScript|damagebuttons        --/|Set this to either "scriptcards", "token-mod", "alterbars", "damagebuttons" or anything else to not apply damage
  --&whisperDamageButtonsToDM|1         --/|If using "damagebuttons" and this is set to 1, the damage buttons will be whispered to the DM instead of being added to the card
  --&whisperDamageButtonResultsToDM|1   --/|If using "damagebuttons" for damage and this value is 1, the DM is whispered a message about damage application
  --&selfHandleAdvantageMode|1          --/|If set to 1, the Action Menu will include advantage/normal/disadvantage toggles (and won't use the character sheet toggle)
  --&defaultAdvantageMode|0             --/|Used with SelfHandleAdvantageMode. 0=Normal, 1=Advantage, 2=Disadvantage
  --&showAdvantageModeText|0            --/|Used with SelfHandleAdvantageMode. 0=Button color coding only. 1=Show "Normal", "Advantage", "Disadvantage" text
  --&compactGlobalModDisplay|1          --/|If set to 1, Global X Mods will use more compact display layouts
  --&EnablePerCharacterConfiguration|1  --/|If set to 1, the Action Menu will create attributes on the character sheet the first time it is executed for a character. It will then use these attributes to generate a configuration menu to allow players to enable/disable some features
  --&DetectPlayersToken|1               --/|If set to a non-zero value, the script will attempt to resolve a character for a player that runs it without a selected token
  --&ShowRestButtons|1                  --/|If set to 1, rest buttons will be shown in the title bar
  --&Template|none                      --/|If you wish to use Keith Curtis' SuperNotes templates, put the template name here
  --&DisplayButtonsForAMAbilities|1     --/|If set to 1, the menu will include custom buttons defined on characters that include the "AM-" prefix in their names.
  --&UseEmojisToReplaceText|0           --/|If set to 1, emojis will be used in place of text in some places

  --/|Adjusting these values will allow you to customize the padding around the action buttons. The default for Roll20 is 5px. The Action
  --/|menu uses slightly smaller buttons (4px) for actions and very small (2px) padding for global modifier and advantage mode toggle buttons.
  --&defaultButtonPadding|3px
  --&smallButtonPadding|2px
  --&bodyFontSize|12
  --&smallFontSize|11
    
  --/|List spells here, separated by semicolons, that should be kept in the PC Attacks display with "[After Cast]" appended to them
  --~|array;define;SpellsToKeepWithSuffix;Spiritual Weapon;Scorching Ray
  
  --~|array;define;NonScalingCantrips;Eldritch Blast

  --/|List spells here, separated by semicolons, that should be kept in the PC Attacks display with no suffix appended to them
  --~|array;define;SpellsToKeepNoSuffix;
  
  --/|=========================================================================================================
  --/| Debug / diagnostics — keep at 0 for production table play
  --/|=========================================================================================================
  --#functionbenchmarking|0             --/|If set to 1, the console will show performance info after the script is run
  --&CamTargetDebug|0                   --/|Set to 1 to whisper GM target/AC diagnostics on EXEC_PC_ATTACK and NPC attacks. Set 0 when done.
  --&CamHealSpellPathDebug|0            --/|Set to 1 to enable ScriptCards line debug for PC heal spell casts (after parse through PC_DONE_SPELL). Set 0 when done.
  --&CamTraceDebug|0                    --/|Set to 1 for ScriptCards debug trace lines on trait/mule button building. Set 0 when done.
  --&AmListDebug|0                      --/|Set to 1 to whisper GM debug lines while building Custom Actions (AMLIST troubleshooting)

  --/|NOTE: This section is experimental and needs further testing. Setting "statusmod_MARKERNAME" allows you to define modifiers that will be applied
  --/|to NPCs based on the status markers active on the NPC. The following modifiers are supported:
  --/| attack:value        (use +X [Desc] to provide a value and description, Can be -X as well) 
  --/| damage:value        (use +X [Desc] to provide a value and description, Can be -X as well)
  --/| rollmode:mode       (use d for disadvantage, a for advantage, n for normal)
  --/| attackermode:mode   (use d for disadvantage, a for advantage, n for normal)
  --/| ac:value            (use +X [Desc] to provide a value and description, Can be -X as well) 
  --/| resist:dmgtypes     (use - to separate damage types, ex bludgeoning-slashing-piercing)
  --/| immune:dmgtypes     (use - to separate damage types, ex bludgeoning-slashing-piercing)
  --/| vuln:dmgtypes       (use - to separate damage types, ex bludgeoning-slashing-piercing)

  --/|For the staus marker mods to work, you will need to set this to 1 and edit/create some modifiers. The items here are just samples.
  --&useTokenMarkersForNPCModifiers|0
  --&statusmod_snail|rollmode:d
  --&statusmod_fist|resist:bludgeoning-piercing-slashing
  --&statusmod_red|damage:+20 [Strong]
  --&statusmod_overdrive|attack:+2 [Haste]
  --&statusmod_tread|ac:-2 [Prone]

  --/|End Settings Area
  --/|=========================================================================================================
  

  --/|=========================================================================================================
  --/|Action Menu Addons Settings
  --?[&UseAddons] -eq "1"|[
    --&PCPostSpellCastFunction|_LibAMA_SpellFumbleOrCrit
    --&PCPostCantripCastFunction|_LibAMA_SpellFumbleOrCrit
    --&PCPostAttackFunction|
    --&NPCPostAttackFunction|
    --&PCSpellListCheck|_LibAMA_SHADOWDARK_SPELL_LIST_CHECK
    --&UseAMASpellCastCheck|1
    --&UseAMAShadowdarkSystem|0
    --?"[&UseAMAShadowdarkSystem]" -eq "1"|&skipPreppedSpellsCheck;1
    --?"[&UseAMAShadowdarkSystem]" -eq "1"|&showPCSpellSlotList;0
  --]|
  --/|Action Menu Addons Settings Area
  --/|=========================================================================================================
  

  -->CHECK_VERSION_INFO|

  --/|Determine if a token is selected or if we need to (and can based on config) automatically find a token for this player.
  --?"[@SC_SelectedTokens()]" -eq "undefined array" -and [&DetectPlayersToken] -ne 1|REPORT_NEED_SELECTED_TOKEN
  --?"[@SC_SelectedTokens()]" -ne "undefined array" -and "[@SC_SelectedTokens()]" -eq "1"|BEGIN_WITH_SC_SELECTED_TOKENS
  --?"[@SC_SelectedTokens()]" -gt 1|REPORT_MULTIPLE_SELECTED_TOKEN
  --?[&DetectPlayersToken] -ne 1 -and "[@SC_SelectedTokens()]" -ne "1"|REPORT_NEED_SELECTED_TOKEN
  --?[&DetectPlayersToken] -ne 1 -and "[@SC_SelectedTokens()]" -eq "1"|BEGIN_WITH_SC_SELECTED_TOKENS
  --?[&SendingPlayerIsGM] -eq 1 -and "[@SC_SelectedTokens()]" -ne "1"|REPORT_NEED_SELECTED_TOKEN

  -->GET_CONTROLLED_TOKENS_FROM_PAGETOKENS|saveTokenID
  --?"[&saveTokenID]" -eq ""|REPORT_NO_TOKENS_ON_PAGE
  --?"[&saveTokenID]" -inc ","|REPORT_MULTIPLE_POSSIBLE_TOKENS
  --^SKIP_SELECTED_TOKENS|

  --:BEGIN_WITH_SC_SELECTED_TOKENS|
  --&saveTokenID|[@SC_SelectedTokens(0)]
  --:SKIP_SELECTED_TOKENS|

  --/|Give the script a reentrant name based on the selected character id so we can have multiple instances at the same time
  --#reentrant|CharacterAction [&saveTokenID]
  --&QB|? --&QB|+{ --&QE|}
  --/|OGL spellhealing detection sig (build ? + { — do not put those two chars adjacent in this file; Roll20 parses them at macro run)
  --&CamOGLHealQuerySig|?
  --&CamOGLHealQuerySig|+{
  --&AB|@ --&AB|+{
  --&TB|& --&TB|+# --&TB|+64 --&TB|+; --&TB|+{
  --&BED|& --&BED|+# --&BED|+128719;
  --&CLOCK|& --&CLOCK|+# --&CLOCK|+128336;
  --&GEAR|& --&GEAR|+# --&GEAR|+x2699;
  --&SPACE|X X --&SPACE|[&SPACE(1,1)]
  --&NB|& --&NB|+nbsp --&NB|+;
  --/|Legacy empty-section cache marker (HTML nbsp entity). Omit section row instead of emitting.
  --&CAM_SectionSpacer|[&NB]
  --&obrac|[ --&cbrac|]
  --&vbar||

  --&ShortRestImage|[&CLOCK]
  --&LongRestImage|[&BED]
  --&SettingsImage|[&GEAR]
  --&ACImage|[b]AC:[&NB][/b]
  --&HPImage|[b]HP:[&NB][/b]
  --&SpeedImage|[b]Speed:[&NB][/b]
  --&SkillCheckImage|Skill
  --&ToolCheckImage|Tool
  --&SavingThrowImage|Save
  --&RepeatImage|Repeat

  --/|Useful Emoticons
  --&emoSpeed|& --&emoSpeed|+# --&emoSpeed|+9193;
  --&emoShield|& --&emoShield|+# --&emoShield|+129355;
  --&emoHeart|& --&emoHeart|+# --&emoHeart|+129505;
  --&emoShield|[img width=25 height=25]https://s3.amazonaws.com/files.d20.io/images/30/JAFfatM7Ius91Eg4uPBY6w/icon.png?1575370642[/img]
  --?[&useGameIconsGraphicsForTitleButtons] -eq 0|SKIP_GAME_ICONS_FOR_TITLES
  --&gameIconsBasePath|https://raw.githubusercontent.com/kjaegers/game-icons/master/transparent/
  --&ShortRestImage|[img width=15 height=15][&gameIconsBasePath]white/meditation.png[/img]
  --&LongRestImage|[img width=15 height=15][&gameIconsBasePath]white/night-sleep.png[/img]
  --&SettingsImage|[img width=15 height=15][&gameIconsBasePath]white/cog.png[/img]
  --&ClearCacheImage|[img width=15 height=15][&gameIconsBasePath]white/anticlockwise-rotation.png[/img]
  --&RepeatImage|[img width=15 height=15][&gameIconsBasePath]white/anticlockwise-rotation.png[/img]
  --:SKIP_GAME_ICONS_FOR_TITLES|
  --?[&useGameIconsGraphics] -eq 0|SKIP_GAME_ICONS
  --/&SkillCheckImage|[img width=15 height=15][&gameIconsBasePath]white/skills.png[/img]
  --/&SavingThrowImage|[img width=15 height=15][&gameIconsBasePath]white/dodging.png[/img]
  --&ACImage|[img width=20 height=20][&gameIconsBasePath][&gameIconsSet]/shield.png[/img][&NB]
  --&HPImage|[img width=20 height=20][&gameIconsBasePath][&gameIconsSet]/health-normal.png[/img][&NB]
  --&SpeedImage|[img width=20 height=20][&gameIconsBasePath][&gameIconsSet]/walk.png[/img][&NB]
  --:SKIP_GAME_ICONS|

  --/|Set up some style information for the action menu and subsequent cards. These attempt to somewhat
  --/|simulate the 5E style
  --#bodyfontface|Helvetica
  --#oddrowfontcolor|#290000
  --#evenrowfontcolor|#290000
  --#bodyfontsize|[&bodyFontSize]px
  --#buttonfontsize|10px
  --#buttonbackground|#930c10
  --#buttonbackground|#672223
  --#buttonbackground|rgba(103,34,35,1); display:inline-block;
  --/#buttonbordercolor|rgba(0,0,0,0)
  --/#buttonbackground|rgba(0,0,0,0); display:inline-block; border:none
  --/#buttontextcolor|#930c10
  --#buttonfontface|Tahoma
  --#titlecardbackgroundcolor|#930c10
  --#titlecardbackgroundcolor|#672223
  --#titlefontcolor|#fffebd
  --#titlefontsize|1.5em
  --#titlefontshadow|0
  --#oddrowbackground|#f7ce65
  --#evenrowbackground|#f7ce65
  --#oddrowbackground|#b3ab96
  --#evenrowbackground|#b3ab96
  --#subtitlefontcolor|#fffebd
  --#tablebgcolor|#fffebd
  --#lineheight|10pt
  --#buttonpadding|[&defaultButtonPadding]
  --#overridetemplate|[&Template]
  --&GAM_Button_Active_Color|009900
  --&GAM_Button_Inactive_Color|672223
  
  --&AMOriginalSendingPlayer|[&SendingPlayerID]

  --/|The menu is whispered to the player executing the macro. #whisper will be set again later for the
  --/|actual output to be public.
  --#whisper|self

  --/|Store the selected character so we can use it later even if it gets de-selected
  --#sourcetoken|[&saveTokenID]
  --&AMCharacterId|[*S:character_id]
  -->VALIDATE_ACTION_MENU_CHARACTER|
  --!a:[&AMCharacterId]|5ECAM_MENU_TID:[&saveTokenID]

  --?[&UseNamedCharacterSettings] -eq 1|[
    --lsettings|[*S:character_name]
  --]|

  -->CAM_SetDamageApplyRoutines|

  --#emotestate|hidden
  --#title|[*S:character_name]

  --:AFTER_ADVMODE_CHANGE|
  --#title|[*S:character_name]

  --#leftsub|Action Menu

  --?[&EnablePerCharacterConfiguration] -eq 0|[
   --&perCharacterOptions|$SGAM1$$SGDM1$$SGSM1$$SGMB1$$SSAS1$$SGCM1$$SGKM1$$SHRB1$
   --#leftsub|Action Menu [rbutton][&ClearCacheImage]::CLEAR_CHARACTER_CACHE[/rbutton]
   --^SKIP_PER_CHAR_SETTINGS|
  --]|
  --#leftsub|Action Menu [rbutton][&SettingsImage]::DISPLAY_CHARACTER_CONFIG_MENU[/rbutton] [rbutton][&ClearCacheImage]::CLEAR_CHARACTER_CACHE[/rbutton]
  -->LOAD_PER_CHARACTER_CONFIG_OPTIONS|[*S:character_id]
  --:SKIP_PER_CHAR_SETTINGS|

  --?[*S:npc] -eq 1|SKIP_REST_BUTTONS
  --?"[&ShowRestButtons]" -ne "1"|SKIP_REST_BUTTONS
  --?"[&perCharacterOptions]" -inc "$SHRB0$"|SKIP_REST_BUTTONS
  --#rightsub|Rest: [rbutton][&ShortRestImage]::DO_SHORT_REST[/rbutton][rbutton][&LongRestImage]::DO_LONG_REST[/rbutton]
  --:SKIP_REST_BUTTONS|

  --/|Determine if the selected character is a PC or NPC and process appropriately
  --?[*S:npc] -eq 1|proc_npc|proc_pc

  --/|=========================================================================================================
  --/|Handle Action Menu creation for NPCs

  --:proc_npc|
  --?"X[&saveTokenID]" -ne "X" -and "[&saveTokenID]" -ne ""|[
   --#sourcetoken|[&saveTokenID]
  --]|
  --/+|[hr #58180d]

  -->BuildCharacterSummary|[*S:t-id];CharSummaryText;npc_ac
  
  --?"[&showCharacterSummary]" -ne "1"|SKIP_NPC_SUMMARY
  --?"[&perCharacterOptions]" -inc "SCS0"|SKIP_NPC_SUMMARY
  --/+|[c][F[&smallFontSize]][&CharSummaryText][/F][/c]
  --+|[&CharSummaryText]
  --:SKIP_NPC_SUMMARY|
  
  --&AdvModeText|

  --?[&selfHandleAdvantageMode] -eq 1|[
    --?"[&currentAdvantageMode]" -eq ""|&currentAdvantageMode;[&defaultAdvantageMode]
    --&mode|
    --?[&showAdvantageModeText] -eq 0|SKIP_NPC_SET_MODE
    --C[&currentAdvantageMode]|0:&mode; Normal|1:&mode; Advantage|2:&mode; Disadvantage
    --:SKIP_NPC_SET_MODE|
    --&nbuttoncolor|#[&GAM_Button_Inactive_Color]
    --&abuttoncolor|#[&GAM_Button_Inactive_Color]
    --&dbuttoncolor|#[&GAM_Button_Inactive_Color]
    --C[&currentAdvantageMode]|0:&nbuttoncolor;#[&GAM_Button_Active_Color]|1:&abuttoncolor;#[&GAM_Button_Active_Color]|2:&dbuttoncolor;#[&GAM_Button_Active_Color]
    --#buttonpadding|[&smallButtonPadding]
    --&AdvModeText|[r][b]Attack Mode:[/b] [&mode][rbutton:#FFFFFF:[&nbuttoncolor]]N::SET_ADV_MODE;0[/rbutton][rbutton:#FFFFFF:[&abuttoncolor]]A::SET_ADV_MODE;1[/rbutton][rbutton:#FFFFFF:[&dbuttoncolor]]D::SET_ADV_MODE;2[/rbutton][/r]    --C[&currentAdvantageMode]|0:&mode;Normal|1:&mode;Advantage|2:&mode;Disadvantage
    --#buttonpadding|[&defaultButtonPadding]
  --]|

  --/|Skill Checks and Saving Throws
  --&savesAndSkills|
  --?[&showNPCSkillsAndSaves] -eq 1 -or "[&perCharacterOptions]" -inc "$SSAS1$"|>BUILD_SAVES_AND_SKILLS_BUTTONS;savesAndSkills
  --/+|[t width='100%'][tr][td align=left][&savesAndSkills][/td][td align=right][&AdvModeText][/td][/tr][tr][td][&NB][/td][td][/td][tr][/t]
  --+|[t width='100%'][tr][td align=left][&savesAndSkills][/td][td align=right][&AdvModeText][/td][/tr][/t][F5][BR][/F]

  --/|5E Sheet Specific BEGIN

  --/|NPC spell buttons: show all spells in repeating sections (no slot-level filter). Cast still checks slots in EXEC_PC_SPELL.
  --&HighestSlot|9
  -->BUILD_BUTTON_LIST|[*S:character_id];repeating_npcaction;name;EXEC_NPC_ACTION;Actions;[&sharednpcmacromulename];0
  -->BUILD_BUTTON_LIST|[*S:character_id];repeating_npcbonusaction;name;EXEC_NPC_BONUS_ACTION;Bonus Actions;[&sharednpcmacromulename];0
  -->BUILD_BUTTON_LIST|[*S:character_id];repeating_npcreaction;name;EXEC_NPC_REACTION;Reactions;[&sharednpcmacromulename];0
  -->BUILD_BUTTON_LIST|[*S:character_id];repeating_npcaction-l;name;EXEC_NPC_LEGENDARY_ACTION;Legendary Actions;[&sharednpcmacromulename];0
  -->BUILD_SPELL_BUTTON_LIST|[*S:character_id];repeating_spell-cantrip;spellname;EXEC_PC_CANTRIP;Cantrips;[&sharednpcmacromulename];0
  --%levelCounter|1;9
    --/\|repeating_spell repeating_spell-[&levelCounter]
    --/\|Spellname-[&spellname]
    -->BUILD_SPELL_BUTTON_LIST|[*S:character_id];repeating_spell-[&levelCounter];spellname;EXEC_PC_SPELL;Level [&levelCounter] Spells;[&spellmulename];[&levelCounter]
  --%|
  --/|5E Sheet Specific END

  --#buttonpadding|[&smallButtonPadding]
  --X|

  --/|=========================================================================================================
  --/|Reentrant points for NPCs. Most of the reentry points set up variables and jump back into the "NPCA_NOT_ATTACK" portion
  --/|of the EXEC_NPC_ACTION code. Note this this code is 5E specific, so you will likely need to replace the entire
  --/|"EXEC_*" sections to carry out specific actions if building for a different sheet

  --:PARSE_NPC_REENTRY|
  --~action_part|string;before;|;[&reentryval]
  --~action_target|string;after;|;[&reentryval]
  --?"[&action_target]" -eq ""|&action_target;NONE
  --&actionBtnName|[&action_part]
  --&action_name|[&action_part]
  --&action_name|[&action_name(replace,-!-!-,;)]
  --&action_name|[&action_name(replace,-!lpar!-,(,)]
  --&action_name|[&action_name(replace,-!rpar!-,))]
  --&action_name|[&action_name(replace,-!plus!-,+,)]
  -->CAM_TargetDebugWhisper|EXEC_NPC_ACTION reentry|reentryval=[&reentryval] action_target=[&action_target]
  --<|

  --/|Load repeating_npcaction row by RID payload or Rfind by name. Sets repeating row on success. On failure go to NPC_ROW_NOT_FOUND.
  --:LOAD_NPC_ACTION_ROW|repeatingSection
  --&_npcRepeatSec|[%1%]
  --?"[&action_part(0,3)]" -eq "RID"|LNAR_BY_RID
  --#parameterdelimiter|$$$
  --Rfind|[*S:character_id]$$$[&action_name]$$$[&_npcRepeatSec]$$$name
  --#parameterdelimiter|;
  --?"[*R:name]" -eq "NoRepeatingAttributeLoaded"|[
   --Rfind|[*S:character_id];[&action_name];[&_npcRepeatSec];name
  --]|
  --?"[*R:name]" -eq "NoRepeatingAttributeLoaded"|[
   --~|hashtable;fromrepeatingsection;[*S:character_id];[&_npcRepeatSec];name;NPCActionLookupHash
   --&_npcRowIdFromHash|[:NPCActionLookupHash("[&action_name]_sectionid")]
   --?"X[&_npcRowIdFromHash]" -ne "X" -and "[&_npcRowIdFromHash]" -ne "" -and "[&_npcRowIdFromHash]" -ne "undefined"|[
    --?"[&_npcRowIdFromHash(0,1)]" -ne "-"|&_npcRowIdFromHash;-[&_npcRowIdFromHash]
    --Rbysectionid|[*S:character_id];[&_npcRepeatSec];[&_npcRowIdFromHash]
   --]|
  --]|
  --?"[*R:name]" -eq "NoRepeatingAttributeLoaded"|>NPC_ROW_NOT_FOUND
  --?"[*R:name]" -eq ""|>NPC_ROW_NOT_FOUND
  --^LNAR_DONE|
  --:LNAR_BY_RID|
  --/|Payload is RID + section id (id may already include a leading hyphen from the sheet).
  --&_npcRowId|[&action_part(after,RID)]
  --?"[&_npcRowId(0,1)]" -ne "-"|&_npcRowId;-[&_npcRowId]
  --Rbysectionid|[*S:character_id];[&_npcRepeatSec];[&_npcRowId]
  --?"[*R:name]" -eq "NoRepeatingAttributeLoaded"|>NPC_ROW_NOT_FOUND
  --&action_name|[*R:name]
  --:LNAR_DONE|
  --&actionBtnName|[&action_name]
  --&actionBtnName|[&actionBtnName(replace,;,-!-!-)]
  --&actionBtnName|[&actionBtnName(replace,(,-!lpar!-)]
  --&actionBtnName|[&actionBtnName(replace,),-!rpar!-)]
  --&actionBtnName|[&actionBtnName(replace,+,-!plus!-)]
  --/|Repeat payload uses RID plus row section id so redo does not rely on Rfind by action name.
  --~|hashtable;fromrepeatingsection;[*S:character_id];[&_npcRepeatSec];name;NPCActionRepeatHash
  --&actionRepeatPayload|RID[:NPCActionRepeatHash("[*R:name]_sectionid")]
  --?"X[&actionRepeatPayload]" -eq "XRID" -or "[&actionRepeatPayload]" -eq "RID"|&actionRepeatPayload;[&actionBtnName]
  --<|

  --:NPC_ROW_NOT_FOUND|
  --&actionNotFoundLabel|[&action_name]
  --?"[&actionNotFoundLabel]" -eq ""|&actionNotFoundLabel;[&actionBtnName]
  --?"[&action_target]" -eq "NONE"|[
   --#emotetext|[*S:t-name] uses [&actionNotFoundLabel]
  --]|[
   --#emotetext|[*S:t-name] uses [&actionNotFoundLabel] against [*T:t-name]
  --]|
  --#leftsub|[*S:character_name]
  --+Action Not Found|The action "[&actionNotFoundLabel]" could not be loaded from [*S:character_name]'s sheet.
  --X|

  --:EXEC_NPC_ACTION|
  --?[&AMOriginalSendingPlayer] -ne [&SendingPlayerID]|YOU_CANNOT_DO_THAT
  -->CAM_SetDamageApplyRoutines|
  -->CAM_RestoreMenuSourceToken|
  --&whisperTarget|
  --?[*S:npc] -eq 1 -and [&AllNPCActionsToSender] -eq 1|&whisperTarget;self
  --#whisper|[&whisperTarget]
  --#emotestate|visible
  -->PARSE_NPC_REENTRY|
  --&npcActionExecLabel|EXEC_NPC_ACTION
  --?"[&action_target]" -eq "NONE"|NPC_ACT_SKIP_TARGET
  --#targettoken|[&action_target]
  --:NPC_ACT_SKIP_TARGET|
  --#leftsub|[*S:character_name]
  --#rightsub|
  -->LOAD_NPC_ACTION_ROW|repeating_npcaction
  --&emoteActionName|[*R:name]
  --~emoteActionName|string;replace;(;[;[&emoteActionName]
  --~emoteActionName|string;replace;);];[&emoteActionName]
  --?"[&action_target]" -eq "NONE"|[
   --#emotetext|[*S:t-name] uses [&emoteActionName]
  --]|[
   --#emotetext|[*S:t-name] uses [&emoteActionName] against [*T:t-name]
  --]|
  --#leftsub|[*R:name]
  --?"[*R:attack_flag]" -ne on|NPCA_NOT_ATTACK
  --?"[*R:attack_tohit]" -eq "NoRepeatingAttributeLoaded"|>NPC_ROW_NOT_FOUND
  --?"X[*R:attack_tohit]" -eq "X"|>NPC_ROW_NOT_FOUND
  --?"[*R:attack_tohit]" -eq ""|>NPC_ROW_NOT_FOUND
  --?"[&action_target]" -eq "NONE"|[
   --#whisper|self
   --+No Target|Choose a target when prompted (Roll20 target picker). This attack was not rolled against AC 0.
   --X|
  --]|
  --:NPCA_MAKE_AN_ATTACK|
    --#rightsub|[rbutton][&RepeatImage]::[&npcActionExecLabel];[&actionRepeatPayload]|[&TB]target|token_id}[/rbutton]
    --&rollType|1d20
    --?"[*S:advantagetoggle]" -inc advantage|&rollType;2d20kh1
    --?"[*S:advantagetoggle]" -inc disadvantage|&rollType;2d20kl1
    -->DETERMINE_NPC_STATUS_MODIFIERS|[*S:t-id];A
    -->DETERMINE_NPC_STATUS_MODIFIERS|[*T:t-id];T 
    --?[&selfHandleAdvantageMode] -eq 1 -and [&currentAdvantageMode] -eq 0|&rollType;1d20
    --?[&selfHandleAdvantageMode] -eq 1 -and [&currentAdvantageMode] -eq 1|&rollType;2d20kh1
    --?[&selfHandleAdvantageMode] -eq 1 -and [&currentAdvantageMode] -eq 2|&rollType;2d20kl1
    --?"[&ANPC_ROLLMODE]" -ne "" -and "[&TNPC_ATTACKAGAINSTMODE]" -eq ""|SKIP_NPC_ATTACK_ROLLMODE_CALC
    --?"[&ANPC_ROLLMODE]" -ne "" -and "[&TNPC_ATTACKAGAINSTMODE]" -eq ""|&rollType;[&ANPC_ROLLMODE]
    --?"[&ANPC_ROLLMODE]" -ne "" -and "[&TNPC_ATTACKAGAINSTMODE]" -eq ""|SKIP_NPC_ATTACK_ROLLMODE_CALC
    --?"[&ANPC_ROLLMODE]" -eq "" -and "[&TNPC_ATTACKAGAINSTMODE]" -ne ""|&rollType;[&TNPC_ATTACKAGAINSTMODE]
    --?"[&ANPC_ROLLMODE]" -eq "" -and "[&TNPC_ATTACKAGAINSTMODE]" -ne ""|SKIP_NPC_ATTACK_ROLLMODE_CALC
    --?"[&ANPC_ROLLMODE]" -eq "1d20" -and "[&TNPC_ROLLMODE]" -eq "1d20"|&rollType;1d20
    --?"[&ANPC_ROLLMODE]" -eq "2d20kh1" -and "[&TNPC_ROLLMODE]" -eq "1d20"|&rollType;2d20kh1
    --?"[&ANPC_ROLLMODE]" -eq "2d20kl1" -and "[&TNPC_ROLLMODE]" -eq "1d20"|&rollType;2d20kl1
    --?"[&ANPC_ROLLMODE]" -eq "2d20kh1" -and "[&TNPC_ROLLMODE]" -eq "2d20kh1"|&rollType;2d20kh1
    --?"[&ANPC_ROLLMODE]" -eq "2d20kl1" -and "[&TNPC_ROLLMODE]" -eq "2d20kl1"|&rollType;2d20kl1
    --?"[&ANPC_ROLLMODE]" -eq "2d20kh1" -and "[&TNPC_ROLLMODE]" -eq "2d20kl1"|&rollType;1d20
    --?"[&ANPC_ROLLMODE]" -eq "2d20kl1" -and "[&TNPC_ROLLMODE]" -eq "2d20kh1"|&rollType;1d20
    --:SKIP_NPC_ATTACK_ROLLMODE_CALC|
    --=ToHit|[&rollType] + [*R:attack_tohit] [&ANPC_ATKMOD]
    --&dmgModType1|
    --&dmgModType2|
    --?"[&UseResistances]" -eq 0|SKIP_NPC_DMG_MODS
    --?"[*T:npc]" -ne 1|NPCA_VS_PC
    -->CheckDamageModifiersNPC|[*T:character_id];dmgModType1;[*R:attack_damagetype];0;0;0;T
    -->CheckDamageModifiersNPC|[*T:character_id];dmgModType2;[*R:attack_damagetype2];0;0;0;T
    --^SKIP_NPC_DMG_MODS|
    --:NPCA_VS_PC|
    -->CheckDamageModifiersNPC|[*T:character_id];dmgModType1;[*R:attack_damagetype];0;0;0;T
    -->CheckDamageModifiersNPC|[*T:character_id];dmgModType2;[*R:attack_damagetype2];0;0;0;T
    --:SKIP_NPC_DMG_MODS|
    -->CAM_TargetDebugSnapshot|[&action_target];EXEC_NPC_ACTION AC
    --=AC|[*T:ac]
    --?"[*T:npc_ac]" -ne ""|=AC;[*T:npc_ac]
    -->CAM_TargetDebugWhisper|EXEC_NPC_ACTION AC used|AC=[$AC.Raw] npc_ac=[*T:npc_ac]
    --?[&sendGmInfo] -eq 1|[
      --+[*R:name] Attack|rolled [$ToHit] vs the target's AC[br][br]
      --*[*R:name] Attack|rolled [$ToHit] vs AC [b][$AC.Raw][/b]
    --]|[
      --+[*R:name] Attack|rolled [$ToHit] vs AC [b][$AC.Raw][/b][br][br]
    --]|
    --/+Roll|[$ToHit.Base]
    --?"[$ToHit.Base]" -eq "20"|NPCA_CRIT
    --?"[$ToHit.Base]" -eq "1"|NPCA_FAIL
    --?"[$ToHit.Total]" -lt [$AC]|NPCA_MISS
    --?"X[*R:attack_damage2]" -ne "X" -and "[*R:attack_damage2]" -ne "" -and "[*R:attack_damage2]" -ne "NoRepeatingAttributeLoaded"|NPCA_HIT_TWODAMAGE
    --=Damage|[*R:attack_damage] [&ANPC_DMGMOD] [&dmgModType1]
    --+Hit|[$Damage] [*R:attack_damagetype]
    --+|[*R:description]
    -->[&damageRoutine]|[&action_target];[&hitPointsBar];[&tempHPBar];-[$Damage.Raw];0;0;1
    --^NPCA_DONE|
    --:NPCA_HIT_TWODAMAGE|
    --=Damage|[*R:attack_damage] [&ANPC_DMGMOD] [&dmgModType1]
    --=Damage2|[*R:attack_damage2] [&ANPC_DMGMOD] [&dmgModType2]
    --=TotalDamage|[$Damage] + [$Damage2]
    --+Hit|[$Damage] [*R:attack_damagetype] and [$Damage2] [*R:attack_damagetype2]
    --+|[*R:description]
    -->[&damageRoutine]|[&action_target];[&hitPointsBar];[&tempHPBar];-[$TotalDamage.Raw];0;0;1
    --^NPCA_DONE|

    --:NPCA_CRIT|
    --?"X[*R:attack_damage2]" -ne "X" -and "[*R:attack_damage2]" -ne "" -and "[*R:attack_damage2]" -ne "NoRepeatingAttributeLoaded"|NPCA_CRIT_TWODAMAGE
    --?"X[*R:attack_crit]" -ne "X" -and "[*R:attack_crit]" -ne "" -and "[*R:attack_crit]" -ne "NoRepeatingAttributeLoaded"|[
     --=Damage|[*R:attack_damage] + [*R:attack_crit] [&ANPC_DMGMOD] [&dmgModType1]
    --]|[ 
     --=Damage|[*R:attack_damage] + [*R:attack_damage] [&ANPC_DMGMOD] [&dmgModType1]
    --]|
    --+Critical|[$Damage] [*R:attack_damagetype]
    --+|[*R:description]
    -->[&damageRoutine]|[&action_target];[&hitPointsBar];[&tempHPBar];-[$Damage.Raw];0;0;1
    --^NPCA_DONE|
    
    --:NPCA_CRIT_TWODAMAGE|
    --?"X[*R:attack_crit]" -ne "X" -and "[*R:attack_crit]" -ne "" -and "[*R:attack_crit]" -ne "NoRepeatingAttributeLoaded"|[
     --=Damage|[*R:attack_damage] + [*R:attack_crit] [&ANPC_DMGMOD] [&dmgModType1]
    --]|[ 
     --=Damage|[*R:attack_damage] + [*R:attack_damage] [&ANPC_DMGMOD] [&dmgModType1]
    --]|
    --?"X[*R:attack_crit2]" -ne "X" -and "[*R:attack_crit2]" -ne "" -and "[*R:attack_crit2]" -ne "NoRepeatingAttributeLoaded"|[
     --=Damage2|[*R:attack_damage2] + [*R:attack_crit2] [&ANPC_DMGMOD] [&dmgModType2]
    --]|[ 
     --=Damage2|[*R:attack_damage2] + [*R:attack_damage2] [&ANPC_DMGMOD] [&dmgModType2]
    --]|
    --=TotalDamage|[$Damage] + [$Damage2]
    --+Critical|[$Damage] [*R:attack_damagetype] and [$Damage2] [*R:attack_damagetype2]
    --+|[*R:description]
    -->[&damageRoutine]|[&action_target];[&hitPointsBar];[&tempHPBar];-[$TotalDamage.Raw];0;0;1
    --^NPCA_DONE|

    --:NPCA_MISS|
    --+Miss|The attack missed.
    --^NPCA_DONE|
	
	--:NPCA_FAIL|
    --+Critical Fail! | You rolled a [$ToHit.Base] on your attack roll.
	--?"[&UseFailTables]" -ne "1"|[
	 --^NPCA_DONE|
	--]|
	--&failTable|
	--?"[*R:attack_type]" -inc "Melee"|&failTable;[&FailTableMelee]
	--?"[*R:attack_type]" -inc "Ranged"|&failTable;[&FailTableRanged]
	--?"[&failTable]" -eq ""|[
	 --^NPCA_DONE|
	--]|
	--+|[br]
	--=Fail|[T#[&failTable]]
    --&failText|[$Fail.tableEntryText]
    --?"[&failText]" -inc "[&obrac][&obrac]"|[
	--~failText1|string;before;[&obrac][&obrac];[&failText]
	--~failText2|string;after;[&cbrac][&cbrac];[&failText]
	--~roll|string;before;[&cbrac][&cbrac];[&failText]
	--~roll|string;after;[&obrac][&obrac];[&roll]
	--=failRoll|[&roll]
	--&failText|[&failText1][$failRoll][&failText2]
	--]|
    --+|[&failText]
	--+|[br]
    --?"[&failText]" -inc "Roll for damage"|[
	--=Damage|[*R:attack_damage] [&ANPC_DMGMOD] [&dmgModType1]
    --=Damage2|[*R:attack_damage2] [&ANPC_DMGMOD] [&dmgModType2]
	--+Damage: |[$Damage]
	--+|[br]
	--]|
    --^NPCA_DONE|
	
